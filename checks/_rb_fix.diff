+
+uint32_t llama_memory_recurrent_context::get_rs_shift(uint32_t i) const {
+    if (is_full || mem->n_rs_seq == 0) {
+        return 0;
+    }
+
+    const uint32_t cell_idx = i + mem->head;
+    if (cell_idx >= mem->cells.size()) {
+        return 0;
+    }
+
+    const auto & cell = mem->cells[cell_idx];
+    if (cell.seq_id.empty()) {
+        return 0;
+    }
+
+    const llama_seq_id seq = *cell.seq_id.begin();
+    if (seq < 0 || (size_t) seq >= mem->rs_idx.size()) {
+        return 0;
+    }
+
+    return mem->rs_idx[seq];
+}
