+        cp2.embeddings          = true;
+        cp2.embeddings_pre_norm = true;
+        llama_context * c2 = llama_init_from_model(m_head2, cp2);
+        if (c2 == nullptr) {
+            printf("[FAIL] remote-chain head context\n");
+            return 1;
+        }
+
+        char err[512] = {0};
+        const char * eps[1] = { ep };
+        const int n_attached = llama_split_attach_remote(c2, eps, 1, err, sizeof(err));
