+std::map<ggml_backend_buffer_type_t, size_t> llama_memory_split::memory_breakdown() const {
+    auto total = head->memory_breakdown();
+    for (auto * m : tails) {
+        for (const auto & it : m->memory_breakdown()) {
+            total[it.first] += it.second;
+        }
+    }
+    return total;
+}
+
+// The chain's state blob. For a local chain it is exactly what it always was -- a stage count,
+// then one self-delimiting blob per stage, head first. A chain with remote stages adds one
+// section, and it comes *before* the head:
+//
+//   uint32_t n_stages      = tails.size() + 1
+//   uint32_t n_remotes                                   (only when remotes is non-empty)
+//   n_remotes x { int32_t pos_max, uint32_t n_bytes, uint8_t bytes[n_bytes] }
+//   head->state_write(...)
+//
+// [QLH-SPLIT] v6: `bytes` is the 8-byte handle the stage minted for its own snapshot
+// (STATE_FLAG_HANDLE), so the whole remote section is 16 bytes per stage instead of 12.56 MiB.
+// The n_bytes field is still there and still self-describing: a blob written by a pre-v6 build
+// carries the state itself in that field, and state_read() still accepts it (a slot file
+// persists checkpoints across builds, and parsing 12.56 MiB of recurrent state as a handle would
+// be exactly the kind of silent misread this layer exists to prevent).
+//
+// Two reasons for that order. A restore must not touch the head until every remote stage has
+// accepted its snapshot (the head is what answers pos_min/pos_max, so a head that moved while a
+// stage did not is precisely the divergence this layer exists to prevent) -- writing the remote
+// section first lets state_read apply it first while still consuming the stream front to back.
+// And a save that fails costs nothing local: the head has not been written to the buffer yet.
+//
+// `pos_max` per stage is what makes a restore safe to trust: all stages are position-split by
+// construction, so they must agree on it at save time, and a stage that has meanwhile moved
+// backwards (cleared, or never got the tokens) is caught before its state is applied.
+static constexpr size_t split_state_remote_hdr = sizeof(int32_t) + sizeof(uint32_t);
+
+// [QLH-SPLIT] The chain's state operations all start with this: a dead chain has no state worth
+// asking for, and asking costs one socket timeout per stage per call. Measured on a chain with a
+// suspended stage: after the operation that discovered the failure, the server went on to query
+// the stage for a checkpoint size and added a second 120 s to the same failing request. Refusing
+// here keeps one failed request down to one timeout.
+const char * llama_memory_split::state_unavailable() const {
+    return remote_failure.empty() ? nullptr : remote_failure.c_str();
+}
+
+size_t llama_memory_split::state_size(llama_seq_id seq_id, llama_state_seq_flags flags) const {
+    if (const char * why = state_unavailable()) {
+        throw std::runtime_error(std::string("the chain is not trustworthy: ") + why);
+    }
+
+    size_t size = sizeof(uint32_t); // n_stages
+
+    size_query_valid = false;
+    size_query_bytes.clear();
+
+    if (!remotes.empty()) {
+        size += sizeof(uint32_t); // n_remotes
+        size_query_bytes.assign(remotes.size(), 0);
+        for (size_t i = 0; i < remotes.size(); ++i) {
+            uint32_t n_bytes = 0;
+            int32_t  pos_max = 0;
+            std::string err;
+            if (!remotes[i]->state_size(seq_id, flags, n_bytes, pos_max, err)) {
+                throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                        remotes[i]->endpoint() + ") failed the state size query: " + err);
+            }
+            // [QLH-SPLIT] v6: this is STATE_HANDLE_BYTES (8), not the stage's 12.56 MiB -- the
+            // stage is asked *with* STATE_FLAG_HANDLE, so it answers with the record it would
+            // mint. The head's whole remote section is 16 bytes per stage; the state itself never
+            // leaves the process that already holds it.
+            size_query_bytes[i] = n_bytes;
+            size += split_state_remote_hdr + n_bytes;
+        }
+        // Remembered for state_write(), which runs in a second round trip and has to detect that
+        // a stage answered a different size than the one the caller's buffer was sized for.
+        size_query_seq   = seq_id;
+        size_query_flags = flags;
+        size_query_valid = true;
+    }
+
+    // the head (and the local tails, if any) count themselves through a dummy io, exactly like
+    // they did before remote stages existed
+    llama_io_write_dummy io(false);
+    head->state_write(io, seq_id, flags);
+    for (auto * m : tails) {
+        m->state_write(io, seq_id, flags);
+    }
+    size += io.n_bytes();
+
+    return size;
+}
+
+void llama_memory_split::state_write(llama_io_write_i & io, llama_seq_id seq_id, llama_state_seq_flags flags) const {
+    if (const char * why = state_unavailable()) {
+        throw std::runtime_error(std::string("the chain is not trustworthy: ") + why);
+    }
+
+    // The chain's state is the concatenation of its stages'. Each stage writes its own
+    // header-less blob; the split context wraps them so a later state_read can hand each
+    // slice back to the stage that produced it.
+    const uint32_t n = (uint32_t) tails.size() + 1;
+
+    if (remotes.empty()) {
+        io.write(&n, sizeof(n));
+        head->state_write(io, seq_id, flags);
+        for (auto * m : tails) {
+            m->state_write(io, seq_id, flags);
+        }
+        return;
+    }
+
+    // Snapshot every stage before any of it is written: the head's position is the yardstick and
+    // a stage that disagrees means the chain is already out of step, which is not something to
+    // bake into a checkpoint that will be restored later.
+    const llama_pos pos_head = head->seq_pos_max(seq_id);
+
+    // [QLH-SPLIT] v6: 8 bytes per stage instead of 12.56 MiB. The stage keeps the snapshot in its
+    // own cache and this is its name for it; the head never reads the bytes, it only stores them
+    // and hands them back, so moving them was pure cost (measured: 0.8-1.2 s per checkpoint at
+    // 16 MB/s, 2.8 s at the 5 MB/s of the field report).
+    std::vector<uint64_t> handles(remotes.size());
+    std::vector<int32_t>  pos_max(remotes.size());
+    for (size_t i = 0; i < remotes.size(); ++i) {
+        std::string err;
+        if (!remotes[i]->state_take(seq_id, flags, handles[i], pos_max[i], err)) {
+            throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                    remotes[i]->endpoint() + ") failed the state save: " + err);
+        }
+        if (pos_max[i] != pos_head) {
+            throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                    remotes[i]->endpoint() + ") is at position " + std::to_string(pos_max[i]) +
+                    " while the head is at " + std::to_string(pos_head) +
+                    "; the chain has drifted, refusing to checkpoint it");
+        }
+    }
+
+    // [QLH-SPLIT] The caller's buffer was sized by state_size(), which asked the stages for their
+    // record size in an earlier round trip. With v6 that answer is a constant, so a mismatch now
+    // means the two ends disagree about the layout (they are built together, so this is a build
+    // skew or a corrupt build), not "the state changed in between". Checking it before the first
+    // write is what keeps it a clean refusal instead of a buffer underflow in
+    // llama_io_write_host::write, which reaches common/common.cpp as a 0-byte save.
+    if (size_query_valid && size_query_seq == seq_id && size_query_flags == flags &&
+            size_query_bytes.size() == remotes.size()) {
+        for (size_t i = 0; i < remotes.size(); ++i) {
+            if (size_query_bytes[i] != STATE_HANDLE_BYTES) {
+                throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                        remotes[i]->endpoint() + ") answered " +
+                        std::to_string(size_query_bytes[i]) + " bytes when the buffer was sized for "
+                        "a snapshot handle (" + std::to_string(STATE_HANDLE_BYTES) + "); the two "
+                        "ends disagree about the state layout, so this checkpoint cannot be written");
+            }
+        }
+    }
+
+    io.write(&n, sizeof(n));
+    const uint32_t n_remotes = (uint32_t) remotes.size();
+    io.write(&n_remotes, sizeof(n_remotes));
+    for (size_t i = 0; i < remotes.size(); ++i) {
+        const uint32_t n_bytes = STATE_HANDLE_BYTES;
+        io.write(&pos_max[i], sizeof(pos_max[i]));
+        io.write(&n_bytes, sizeof(n_bytes));
+        io.write(&handles[i], sizeof(handles[i]));
+    }
+
+    head->state_write(io, seq_id, flags);
+    for (auto * m : tails) {
+        m->state_write(io, seq_id, flags);
+    }
+}
+
+void llama_memory_split::state_read(llama_io_read_i & io, llama_seq_id seq_id, llama_state_seq_flags flags) {
+    if (const char * why = state_unavailable()) {
+        throw std::runtime_error(std::string("the chain is not trustworthy: ") + why);
+    }
+
+    uint32_t n = 0;
+    io.read(&n, sizeof(n));
+
+    if (n != tails.size() + 1) {
+        throw std::runtime_error("split memory state: stage count mismatch");
+    }
+
+    if (!remotes.empty()) {
+        uint32_t n_remotes = 0;
+        io.read(&n_remotes, sizeof(n_remotes));
+        if (n_remotes != remotes.size()) {
+            throw std::runtime_error("split memory state: remote stage count mismatch (" +
+                    std::to_string(n_remotes) + " in the blob, " + std::to_string(remotes.size()) +
+                    " attached)");
+        }
+
+        // [QLH-SPLIT] v6: a record is either a snapshot handle (8 bytes) or, from a slot file
+        // written by a pre-v6 build, the state blob itself. Both are self-describing, so they are
+        // still told apart by their length and the old file keeps working.
+        std::vector<uint64_t>              handles(n_remotes, 0);
+        std::vector<std::vector<uint8_t>>  blobs(n_remotes);
+        std::vector<bool>                  is_handle(n_remotes, false);
+        std::vector<int32_t>               pos_max(n_remotes);
+        for (uint32_t i = 0; i < n_remotes; ++i) {
+            uint32_t n_bytes = 0;
+            io.read(&pos_max[i], sizeof(pos_max[i]));
+            io.read(&n_bytes, sizeof(n_bytes));
+            if (n_bytes > MAX_STATE) {
+                throw std::runtime_error("split memory state: implausible remote stage size");
+            }
+            if (n_bytes == STATE_HANDLE_BYTES) {
+                is_handle[i] = true;
+                io.read(&handles[i], sizeof(handles[i]));
+            } else {
+                blobs[i].resize(n_bytes);
+                if (n_bytes > 0) {
+                    io.read(blobs[i].data(), n_bytes);
+                }
+            }
+        }
+
+        // Cleared here, not after the loop: it describes this attempt, and a caller that asks
+        // after a failed restore must not read the answer of the previous one.
+        state_stale = false;
+
+        // Restore the remote stages first, head last: the caller reads its positions from the
+        // head, so the head must not move unless every stage after it has.
+        for (uint32_t i = 0; i < n_remotes; ++i) {
+            std::string err;
+            int32_t pos_before = -1;
+            bool    stale      = false;
+            const bool ok = is_handle[i]
+                    ? remotes[i]->state_give(seq_id, flags, handles[i], pos_max[i], pos_before, stale, err)
+                    : remotes[i]->state_load(seq_id, flags, blobs[i], pos_max[i], pos_before, err);
+            if (!ok) {
+                // [QLH-SPLIT] A restore that stops here leaves the chain split-brained: the
+                // stages before this one were rewound to the snapshot, this one and the ones
+                // after it were not, and the head (restored last) was not either. Nothing
+                // later repairs that on its own -- a transport failure would show up again as
+                // a timeout on the next operation -- so the chain is marked dead exactly like
+                // a failed seq_rm. The throw is then a failed request (common/common.cpp /
+                // tools/server report it) instead of a dead server; decode_split refuses from
+                // here on, so the split brain can never be read from.
+                if (remote_failure.empty()) {
+                    remote_failure = "remote stage " + std::to_string(i + 1) + " (" +
+                                     remotes[i]->endpoint() + ") failed the state restore: " + err;
+                }
+                throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                        remotes[i]->endpoint() + ") failed the state load: " + err);
+            }
+            if (stale) {
+                // [QLH-SPLIT] v6: the stage no longer holds the snapshot this checkpoint names.
+                // Unlike the branch above, *nothing* was applied -- the stage refused before it
+                // touched its memory, and the head is read last -- so no stage moved and the
+                // chain is not split-brained. The only thing that is gone is one checkpoint, so
+                // this is reported separately (state_stale) and the server recovers the way it
+                // already does for a server started without checkpoints: re-process the prompt.
+                // Treating it as remote_failure would kill every following request for a cache
+                // eviction.
+                state_stale = true;
+                throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                        remotes[i]->endpoint() + ") no longer holds the checkpoint's snapshot "
+                        "(it was evicted, or the stage was restarted); the chain was not touched "
+                        "and the prompt has to be re-processed");
+            }
+            // A stage that has moved backwards lost the prefix this snapshot sits on (a clear, a
+            // restart, a different sequence), and restoring on top of that would silently
+            // compute from positions it never decoded. Moving *forward* is the normal case: the
+            // checkpoint is older than the current state by construction.
+            if (pos_before < pos_max[i]) {
+                if (remote_failure.empty()) {
+                    remote_failure = "remote stage " + std::to_string(i + 1) + " (" +
+                                     remotes[i]->endpoint() + ") is at position " +
+                                     std::to_string(pos_before) + ", behind the checkpoint's " +
+                                     std::to_string(pos_max[i]) +
+                                     "; the chain has drifted and cannot be restored into it";
+                }
+                throw std::runtime_error("remote stage " + std::to_string(i + 1) + " (" +
+                        remotes[i]->endpoint() + ") is at position " + std::to_string(pos_before) +
+                        ", behind the checkpoint's " + std::to_string(pos_max[i]) +
+                        "; refusing to restore the chain into it");
+            }
+        }
+    }
+
+    head->state_read(io, seq_id, flags);
+    for (auto * m : tails) {
+        m->state_read(io, seq_id, flags);
+    }
+}
diff --git a/src/llama-memory-split.h b/src/llama-memory-split.h
new file mode 100644
index 000000000..d2b5be014
--- /dev/null
+++ b/src/llama-memory-split.h
@@ -0,0 +1,233 @@
+// [QLH-SPLIT] Memory view over a chain of stages.
+//
+// A split context has one KV cache per stage, but llama-server talks to a single
+// llama_memory_t. This object presents the union: queries that must be consistent across the
+// chain are answered from the head, mutations are broadcast to every stage, and anything that
+// would move positions inside a stage (shifting) is refused outright because the stages would
+// diverge silently.
+//
+// Design notes worth keeping:
+//  - init_batch / init_full / init_update go to the head only. The ubatch decomposition is a
+//    property of the batch and the head's capacity; the tail stages consume the hidden rows
+//    that the head already split, so they never get to choose differently.
+//  - seq_rm must succeed on EVERY stage, and a stage that dropped a range while another kept it
+//    is exactly the divergence this whole layer exists to prevent. What happens to a false
+//    return depends on the kind of stage: a local chain still aborts in common/common.cpp (the
+//    process is the only thing that can be inconsistent, and it cannot be repaired in place),
+//    while a failed REMOTE stage marks the chain dead (remote_failure) and the request fails.
+//    The difference is the failure being transient and outside the process (a dropped frame)
+//    versus in-process state that is definitely wrong. Neither path ever serves a token from a
+//    diverged chain: decode_split checks the flag first.
+//  - can_shift is false. Shifting rewrites positions inside one stage's KV; with positions
+//    being the only thing tying the stages together, that cannot be done safely, and the
+//    server already degrades gracefully when can_shift is false.
+//  - state_write / state_read are the whole chain. llama-server's context checkpoints save and
+//    restore the sequence state, and a checkpoint that covered only the head would leave the
+//    tails at their pre-checkpoint positions: the head would look rewound (pos_min/pos_max come
+//    from the head) while the next truncating seq_rm still had to rewind a tail's recurrent
+//    state, which no finite n_rs_seq could honour. llama_context therefore routes its state
+//    through get_memory(), not its `memory` member -- keep that way.
+//    Remote stages join that blob (see llama-memory-split.cpp for the layout). The wire carries
+//    the recurrent state only, because for a model without SWA the checkpoint flavour
+//    (LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) writes no KV at all -- llama-kv-cache.cpp returns
+//    immediately. That is why the per-stage blob is a constant 6.4 MiB for an 8-layer qwen35
+//    range no matter how long the prompt is.
+//
+//    [v6] That blob is no longer *moved* through the head. A remote stage is asked to keep the
+//    snapshot and answers with a handle, so the record the head stores per stage is 16 bytes
+//    instead of 12.56 MiB, and a restore is 8 bytes up instead of the whole blob. The bytes on
+//    both sides of the change are the same state -- the stage snapshots exactly what it used to
+//    send -- so a checkpoint still restores bit for bit. See STATE_FLAG_HANDLE / ST_STALE in
+//    llama-split-proto.h and `state_stale` below for what a missing handle means.
+//  - Remote stages are held here too, as borrowed pointers, so that the server's KV bookkeeping
+//    (seq_rm in particular) reaches them. A remote stage has no local memory object to call, so
+//    the dispatch is a separate loop over `remotes` rather than a second kind of tail.
+//
+// What a remote stage can and cannot do with positions -- this is the boundary the error policy
+// in llama-split-remote.h is built on:
+//  - it CAN append: decode_split hands it every token's position verbatim, so its KV is
+//    position-identical to the head's by construction.
+//  - it CAN drop everything (p0 = 0): a full clear needs no history, on any memory type.
+//  - it CANNOT rewind arbitrarily: removing [p0, p1) needs the recurrent state behind p0, and a
+//    stage only keeps n_rs_seq tokens of snapshots. In practice llama-server does not even ask:
+//    for a hybrid like qwen35 the aggregate memory reports pos_min == pos_max == the last
+//    position after any decode (measured on the whole model: 80 prompt tokens -> 79/79, 96 ->
+//    95/95), so as soon as the shared prefix ends before the cached one, its reuse path takes
+//    the "restore a context checkpoint, otherwise re-process the prompt" branch. A remote chain
+//    can take the same branch: its checkpoints carry the stages' state too (state_write /
+//    state_read below), so the restore path works over the wire. The refusal in seq_rm is for
+//    the general case: a model or server path where the distance is real is exactly the case
+//    where carrying on would compute from positions the head no longer has.
+//  - it CAN restore a checkpoint, but only the checkpoint flavour: the wire carries the recurrent
+//    state (LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY), and llama_context::state_seq_get_size reports 0
+//    for the full flavour of a remote chain, so prompt_cache (full states) is skipped and the
+//    server's context checkpoints (partial) are the ones that work. A restore that fails part-way
+//    is recorded as a dead chain: the stages before the failure were rewound and the others were
+//    not, and no later operation can repair that. That is what the throw in state_read() becomes
+//    -- a failed request with the reason, not a dead server.
+//    (The numbers below were measured before remote stages could carry their checkpoint state;
+//     they are kept for the design rationale, not as the current cost model -- the partial
+//     flavour does round-trip now, see [G2] in tests/split-smoke.cpp.)
+//    What this costs, measured with a server on either side of the same model:
+//     - a prompt that continues the previous token stream exactly (the client appends what the
+//       model produced) reuses everything: 33-token second turn -> prompt_n = 1, 50 ms, same as
+//       the same server without remote stages;
+//     - a chat request whose history the client re-renders (messages -> template, as every chat
+//       API client does) reuses nothing: 111-token third turn -> prompt_n = 111, 1070 ms, where
+//       the local server restores a checkpoint at the last user message and decodes 45
+//       (274 ms). The gap is the conversation history, so it grows with the session.
+//    Closing that gap means letting a stage keep its own checkpoints -- a protocol change that
+//    does not move KV over the wire, but a change nonetheless. Until then a remote chain is for
+//    append-only prompt reuse, not for long re-rendered chat histories.
+#pragma once
+
+#include "llama-memory.h"
+
+#include <cstdint>
+
+// Only pointers are stored: the wire client drags in the socket headers, and this view is
+// included far more widely than the stage protocol needs to be.
+struct llama_split_remote;
+
+struct llama_memory_split : llama_memory_i {
+    // Not owned. `head` is the context this view was installed on.
+    llama_memory_t              head;
+    std::vector<llama_memory_t> tails;
+    // Not owned. llama_context::split_remotes owns these and outlives this view; an empty list
+    // means a local chain, exactly like before remote stages existed.
+    //
+    // mutable because state_write() is a const override but has to ask each stage for its
+    // snapshot: the vector is a list of handles, not chain state, and the calls only read the
+    // stage. (state_read() is non-const and needs no such treatment.)
+    mutable std::vector<llama_split_remote *> remotes;
+
+    llama_memory_split(llama_memory_t head,
+                       const std::vector<llama_memory_t> & tails,
+                       const std::vector<llama_split_remote *> & remotes)
+        : head(head), tails(tails), remotes(remotes) {}
+
+    // Non-empty once a remote stage failed an operation the chain cannot survive: clear() (no
+    // error channel at all), or seq_rm(), whose false still aborts a *local* chain in
+    // common/common.cpp but must not kill the process for a remote one. The chain cannot be
+    // repaired from here, so decode_split refuses to run and reports this string, and seq_rm
+    // answers false without touching the network: the alternatives are serving hidden states
+    // from a KV that was never cleared, or one socket timeout of latency per request.
+    //
+    // One failure is not permanent any more, but until it is repaired the chain is dead: the
+    // flag is cleared when a later clear() succeeds on every stage (all stages empty again is
+    // the consistent state this layer can re-establish, see llama_memory-split.cpp) or when the
+    // chain is rebuilt by re-attaching, which constructs a fresh view. What it must not do is
+    // clear itself on an unrelated success: a decode that happens to work says nothing about
+    // whether the stage that missed the clear still holds the old KV.
+    //
+    // Read it through llama_context_split_failed()/llama_context_split_failure()
+    // (src/llama-ext.h) rather than directly: this string is written by the thread that drives
+    // the chain, and those two are the declared way for the rest of the tree to ask.
+    std::string remote_failure;
+
+    llama_memory_context_ptr init_batch(
+            llama_batch_allocr & balloc,
+            uint32_t n_ubatch,
+            bool embd_all) override;
+
+    llama_memory_context_ptr init_full() override;
+    llama_memory_context_ptr init_update(llama_context * lctx, bool optimize) override;
+
+    bool get_can_shift() const override;
+
+    void clear(bool data) override;
+
+    bool seq_rm  (llama_seq_id seq_id,                              llama_pos p0, llama_pos p1) override;
+    void seq_cp  (llama_seq_id seq_id_src, llama_seq_id seq_id_dst, llama_pos p0, llama_pos p1) override;
+    void seq_keep(llama_seq_id seq_id) override;
+    void seq_add (llama_seq_id seq_id,                              llama_pos p0, llama_pos p1, llama_pos shift) override;
+    void seq_div (llama_seq_id seq_id,                              llama_pos p0, llama_pos p1, int d) override;
+
+    llama_pos seq_pos_min(llama_seq_id seq_id) const override;
+    llama_pos seq_pos_max(llama_seq_id seq_id) const override;
+
+    // [QLH-SPLIT] Self-heal: re-establish a chain that was marked dead, in place.
+    //
+    // A dead chain is one where a stage stopped answering (or answered wrong) while the others
+    // kept going: from that moment no stage's KV agrees with another's, and the only state this
+    // layer can put *every* stage into without moving data between machines is "all empty".
+    //
+    // So a rebuild is: reconnect every remote stage (close without BYE, bounded connect), then
+    // clear the whole chain, then hand the connection back to the data-path timeout. When this
+    // returns true the head, the local tails and every remote stage hold nothing, and the caller
+    // may decode a batch into it.
+    //
+    // `batch_starts_at_zero` is the safety interlock, and it is not advisory: an empty chain can
+    // only be written from position 0. A batch that continues from positions the chain no longer
+    // holds anywhere would decode into a KV that is empty while the positions keep counting --
+    // exactly the silent-wrong-token state this layer exists to prevent. In that case nothing is
+    // tried (no network, no reconnect) and the call answers false; the caller fails the request,
+    // the server's existing decode-error path drops the slot's cached prompt, and the next
+    // request starts at 0 and can be rebuilt.
+    //
+    // Returns true only when the chain is healthy again *and* usable for this batch. False
+    // leaves remote_failure set (with a reason) and the chain dead.
+    bool try_rebuild(bool batch_starts_at_zero, std::string & err);
+
+    std::map<ggml_backend_buffer_type_t, size_t> memory_breakdown() const override;
+
+    void state_write(llama_io_write_i & io, llama_seq_id seq_id = -1, llama_state_seq_flags flags = 0) const override;
+    void state_read (llama_io_read_i  & io, llama_seq_id seq_id = -1, llama_state_seq_flags flags = 0) override;
+
+    // Size in bytes that state_write() would produce, without producing it.
+    //
+    // llama_context::state_seq_get_size needs it before the buffer exists, and for a chain with
+    // remote stages a plain dummy write is not enough: it would have to fetch every stage's
+    // snapshot just to count it. This asks the stages for sizes instead (one round trip each).
+    size_t state_size(llama_seq_id seq_id, llama_state_seq_flags flags) const;
+
+    // What the last state_size() asked the remote stages for.
+    //
+    // The size and the blob are two separate round trips: llama_context::state_seq_get_size
+    // sizes the caller's buffer, state_seq_get_data fills it. A stage whose state changes in
+    // between answers the second call with a different byte count, and the caller's buffer was
+    // sized from the first answer. state_write() compares against these and fails *before it
+    // writes anything* (every stage's blob is fetched before the first write), so the failure
+    // is a clean "this round cannot be checkpointed" instead of a buffer underflow in
+    // llama_io_write_host::write, which reaches common/common.cpp as a 0-byte save.
+    //
+    // mutable because state_write() is a const override and this is a record of the last query,
+    // not chain state.
+    mutable bool                  size_query_valid = false;
+    mutable llama_seq_id          size_query_seq   = -1;
+    mutable llama_state_seq_flags size_query_flags = 0;
+    mutable std::vector<uint32_t> size_query_bytes;
+
+    // [QLH-SPLIT] v6: the last state_read() found a snapshot the stage no longer holds.
+    //
+    // This is *not* remote_failure. A stale handle means the stage evicted the snapshot (its
+    // cache is bounded) or the stage is not the process that minted it; the stage refuses before
+    // applying anything, and the head has not been read yet either, so every stage is still
+    // exactly where it was. The chain is intact; the only thing that is gone is a checkpoint, and
+    // llama-server already has a path for "no cache data": re-process the prompt. The server asks
+    // through llama_context_split_state_stale() (src/llama-ext.h) and must keep that apart from
+    // remote_failure, which is fatal for the request.
+    //
+    // Cleared at the start of every state_read(), so it always describes the attempt that just
+    // failed rather than a previous one.
+    mutable bool state_stale = false;
+
+private:
+    // remote_failure as a C string, nullptr while the chain is healthy. Every state operation
+    // starts by asking: a dead chain's state must not be asked for (one socket timeout per stage
+    // per call, for an answer nobody can use). See the definition for the measurement.
+    const char * state_unavailable() const;
+
+    // Rebuild bookkeeping (try_rebuild). `rebuild_last_ms` is a steady_clock stamp of the last
+    // attempt, -1 before the first one; `rebuild_attempts` exists so the log can count attempts
+    // instead of leaving an operator to guess whether the throttle is working.
+    int64_t  rebuild_last_ms   = -1;
+    uint64_t rebuild_attempts  = 0;
+
+    // Makes the chain unusable for the next decode, with `op` in the reason. Used by the
+    // operations the stage protocol does not carry: they are unreachable from llama-server today
+    // (see the position notes at the top of this header), but if one ever arrives, the stages
+    // would keep a stale copy of each other and every later hidden state would be wrong with
+    // nothing to detect it.
+    void reject_remote(const char * op);
+};
diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 485483ba1..65261767a 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -10,6 +10,8 @@
 #include <array>
 #include <cinttypes>
 #include <cstdint>
+#include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <future>
 #include <regex>
@@ -546,7 +548,9 @@ llama_model_loader::llama_model_loader(
         bool no_alloc,
         bool load_mtp,
         const llama_model_kv_override * param_overrides_p,
-        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p)
+        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p,
+        int32_t param_split_layer_lo,
+        int32_t param_split_layer_hi)
         : metadata(meta), set_tensor_data(set_tensor_data), set_tensor_data_ud(set_tensor_data_ud) {
     int trace = 0;
     if (getenv("LLAMA_TRACE")) {
@@ -719,6 +723,73 @@ llama_model_loader::llama_model_loader(
         llm_kv = LLM_KV(llm_arch_from_string(arch_name));
     }
 
+    // [C-scheme] LLAMA_LAYER_RANGE=lo:hi — expose source layers [lo, hi) as local layers 0..N-1.
+    // The metadata is already parsed here, so the override lands before load_hparams() reads it.
+    // [QLH-SPLIT] The params win: a split context loads several ranges in one process, and an
+    // env var is process-wide. The env var stays as the fallback for stage-per-process runs.
+    {
+        int lo = param_split_layer_lo;
+        int hi = param_split_layer_hi;
+        if (lo < 0 || hi <= lo) {
+            lo = 0;
+            hi = 0;
+            if (const char * lr = getenv("LLAMA_LAYER_RANGE")) {
+                sscanf(lr, "%d:%d", &lo, &hi);
+            }
+        }
+        if (lo >= 0 && hi > lo && !arch_name.empty()) {
+            layer_lo = lo;
+            layer_hi = hi;
+
+            llama_model_kv_override ov{};
+            ov.tag     = LLAMA_KV_OVERRIDE_TYPE_INT;
+
+            // The real layer counts, captured before the override lands: role inference needs
+            // n_layer_src to know whether hi is the model's last layer, and a tail range needs the
+            // original nextn to keep the MTP head.
+            char bc_key[256];
+            snprintf(bc_key, sizeof(bc_key), "%s.block_count", arch_name.c_str());
+            const int bc_idx = gguf_find_key(metadata, bc_key);
+            int32_t nextn_all = 0;
+            char nx_key[256];
+            snprintf(nx_key, sizeof(nx_key), "%s.nextn_predict_layers", arch_name.c_str());
+            const int nx_idx = gguf_find_key(metadata, nx_key);
+            if (nx_idx >= 0) {
+                nextn_all = (int32_t) gguf_get_val_u32(metadata, nx_idx);
+            }
+            if (bc_idx >= 0) {
+                // block_count counts the MTP layer too (Qwen3.6: 41 = 40 trunk + 1 nextn), so the
+                // trunk depth is block_count - nextn. Without subtracting, a tail range would look
+                // like a middle range and skip `output`.
+                n_layer_src = (int32_t) gguf_get_val_u32(metadata, bc_idx) - nextn_all;
+            }
+
+            // Only the tail range keeps the MTP head: it is the range whose last layer is the
+            // model's last layer, so blk.<n_layer_src>.nextn.* belongs to it. The local block count
+            // then includes the head, and get_weight() maps local n to source lo + n, which lands
+            // exactly on that block.
+            const int32_t nextn_keep = (layer_hi >= n_layer_src && nextn_all > 0) ? nextn_all : 0;
+            tail_keeps_mtp = nextn_keep > 0;
+
+            ov.val_i64 = (layer_hi - layer_lo) + nextn_keep;
+            snprintf(ov.key, sizeof(ov.key), "%s.block_count", arch_name.c_str());
+            kv_overrides[std::string(ov.key)] = ov;
+
+            ov.val_i64 = nextn_keep;
+            snprintf(ov.key, sizeof(ov.key), "%s.nextn_predict_layers", arch_name.c_str());
+            kv_overrides[std::string(ov.key)] = ov;
+
+            // Globals this range cannot use are made lazy instead of read (see create_tensor).
+            lazy.force = true;
+
+            LLAMA_LOG_INFO("%s: [C-scheme] layers [%d, %d) of %d, block_count -> %d, nextn -> %d, "
+                    "globals: tok_embd=%s output=%s\n",
+                    __func__, (int) layer_lo, (int) layer_hi, (int) n_layer_src,
+                    (int) (layer_hi - layer_lo + nextn_keep), (int) nextn_keep,
+                    needs_tok_embd() ? "load" : "skip", needs_output() ? "load" : "skip");
