diff --git a/src/llama-split-net.cpp b/src/llama-split-net.cpp
new file mode 100644
index 000000000..246b7eb37
--- /dev/null
+++ b/src/llama-split-net.cpp
@@ -0,0 +1,225 @@
+// [QLH-SPLIT] See llama-split-net.h.
+#include "llama-split-net.h"
+
+#ifndef _WIN32
+// timeval for SO_RCVTIMEO/SO_SNDTIMEO: <sys/socket.h> is not required to pull it in.
+#  include <sys/time.h>
+// iovec/writev for send_two (scatter/gather).
+#  include <sys/uio.h>
+// fcntl / errno for the bounded connect below.
+#  include <fcntl.h>
+#  include <cerrno>
+#endif
+
+namespace qlh_split::net {
+
+bool global_init() {
+#ifdef _WIN32
+    static bool ready = false;
+    if (!ready) {
+        WSADATA wsa;
+        if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+            return false;
+        }
+        ready = true;
+    }
+#endif
+    return true;
+}
+
+void close_sock(sock_t s) {
+    if (!valid(s)) {
+        return;
+    }
+#ifdef _WIN32
+    closesocket(s);
+#else
+    ::close(s);
+#endif
+}
+
+bool send_all(sock_t s, const void * src, size_t n) {
+    const auto * p = (const uint8_t *) src;
+    while (n > 0) {
+        const int put = (int) send(s, (const char *) p, (int) n, 0);
+        if (put <= 0) {
+            return false;
+        }
+        p += put;
+        n -= (size_t) put;
+    }
+    return true;
+}
+
+bool send_two(sock_t s, const void * a, size_t na, const void * b, size_t nb) {
+    // Scatter/gather, not memcpy: see the header. The loop only matters when the kernel accepts
+    // part of the request (a full send buffer, or a signal on POSIX); a partial transfer has to
+    // be resumed from the first buffer that still has bytes left, so the split is tracked here
+    // instead of in the caller.
+    const auto * pa = (const uint8_t *) a;
+    const auto * pb = (const uint8_t *) b;
+    while (na > 0 || nb > 0) {
+#ifdef _WIN32
+        WSABUF bufs[2];
+        DWORD nbufs = 0;
+        if (na > 0) {
+            bufs[nbufs].buf = (char *) pa;
+            bufs[nbufs].len = (ULONG) na;
+            ++nbufs;
+        }
+        if (nb > 0) {
+            bufs[nbufs].buf = (char *) pb;
+            bufs[nbufs].len = (ULONG) nb;
+            ++nbufs;
+        }
+        DWORD sent = 0;
+        if (WSASend(s, bufs, nbufs, &sent, 0, nullptr, nullptr) == SOCKET_ERROR || sent == 0) {
+            return false;
+        }
+        size_t left = (size_t) sent;
+#else
+        iovec iov[2];
+        int nbufs = 0;
+        if (na > 0) {
+            iov[nbufs].iov_base = (void *) pa;
+            iov[nbufs].iov_len  = na;
+            ++nbufs;
+        }
+        if (nb > 0) {
+            iov[nbufs].iov_base = (void *) pb;
+            iov[nbufs].iov_len  = nb;
+            ++nbufs;
+        }
+        const ssize_t sent = writev(s, iov, nbufs);
+        if (sent <= 0) {
+            return false;
+        }
+        size_t left = (size_t) sent;
+#endif
+        if (left < na) {
+            pa += left;
+            na -= left;
+        } else {
+            left -= na;
+            na = 0;
+            pb += left;
+            nb -= left;
+        }
+    }
+    return true;
+}
+
+bool set_nodelay(sock_t s) {
+    if (!valid(s)) {
+        return false;
+    }
+    int one = 1;
+#ifdef _WIN32
+    return setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char *) &one, sizeof(one)) == 0;
+#else
+    return setsockopt(s, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one)) == 0;
+#endif
+}
+
+bool recv_all(sock_t s, void * dst, size_t n) {
+    auto * p = (uint8_t *) dst;
+    while (n > 0) {
+        const int got = (int) recv(s, (char *) p, (int) n, 0);
+        if (got <= 0) {
+            return false;
+        }
+        p += got;
+        n -= (size_t) got;
+    }
+    return true;
+}
+
+bool set_timeout(sock_t s, int ms) {
+    if (!valid(s) || ms <= 0) {
+        return false;
+    }
+#ifdef _WIN32
+    // Winsock wants a DWORD of milliseconds for both options, not a timeval.
+    const DWORD dw = (DWORD) ms;
+    const bool ok_rcv = setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char *) &dw, sizeof(dw)) == 0;
+    const bool ok_snd = setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const char *) &dw, sizeof(dw)) == 0;
+#else
+    timeval tv{};
+    tv.tv_sec  = ms / 1000;
+    tv.tv_usec = (ms % 1000) * 1000;
+    const bool ok_rcv = setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) == 0;
+    const bool ok_snd = setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)) == 0;
+#endif
+    return ok_rcv && ok_snd;
+}
+
+bool connect_timeout(sock_t s, const struct sockaddr * addr, int addrlen, int ms) {
+    if (!valid(s) || addr == nullptr) {
+        return false;
+    }
+    if (ms <= 0) {
+        return ::connect(s, addr, addrlen) == 0;
+    }
+
+    // Non-blocking for the duration of the connect only. The caller's send/recv helpers assume a
+    // blocking socket, and this file is the only place that is allowed to flip that.
+#ifdef _WIN32
+    u_long nb = 1;
+    if (ioctlsocket(s, FIONBIO, &nb) != 0) {
+        return false;
+    }
+#else
+    const int flags = fcntl(s, F_GETFL, 0);
+    if (flags < 0 || fcntl(s, F_SETFL, flags | O_NONBLOCK) < 0) {
+        return false;
+    }
+#endif
+
+    bool ok = ::connect(s, addr, addrlen) == 0;
+    if (!ok) {
+#ifdef _WIN32
+        const int err = WSAGetLastError();
+        const bool in_progress = (err == WSAEWOULDBLOCK);
+#else
+        const bool in_progress = (errno == EINPROGRESS);
+#endif
+        if (in_progress) {
+            fd_set wfds;
+            FD_ZERO(&wfds);
+            FD_SET(s, &wfds);
+            timeval tv{};
+            tv.tv_sec  = ms / 1000;
+            tv.tv_usec = (ms % 1000) * 1000;
+#ifdef _WIN32
+            const int sel = select(0, nullptr, &wfds, nullptr, &tv); // nfds is ignored on Windows
+#else
+            const int sel = select(s + 1, nullptr, &wfds, nullptr, &tv);
+#endif
+            if (sel > 0) {
+                // Readable-for-write only means the attempt finished; SO_ERROR says how.
+                int so_err = 0;
+#ifdef _WIN32
+                int so_len = (int) sizeof(so_err);
+#else
+                socklen_t so_len = sizeof(so_err);
+#endif
+                if (getsockopt(s, SOL_SOCKET, SO_ERROR, (char *) &so_err, &so_len) == 0) {
+                    ok = (so_err == 0);
+                }
+            }
+        }
+    }
+
+    // Back to blocking on every path, including the failures: a socket that stays non-blocking
+    // would turn every later send/recv into an EWOULDBLOCK the rest of this layer reads as a
+    // dead peer.
+#ifdef _WIN32
+    nb = 0;
+    ioctlsocket(s, FIONBIO, &nb);
+#else
+    fcntl(s, F_SETFL, flags);
+#endif
+    return ok;
+}
+
+} // namespace qlh_split::net
diff --git a/src/llama-split-net.h b/src/llama-split-net.h
new file mode 100644
index 000000000..683bc0f1c
--- /dev/null
+++ b/src/llama-split-net.h
@@ -0,0 +1,142 @@
+// [QLH-SPLIT] One place for the socket plumbing shared by both ends of a stage connection.
+//
+// The client (src/llama-split-remote.cpp) and the server (tools/split-stage/main.cpp) were
+// each carrying their own send_all/recv_all/close_sock/WSAStartup. Two copies of the same
+// four functions is exactly the kind of drift that ends with one end handling a short write
+// and the other not.
+//
+// Deliberately not reusing ggml-rpc's socket helpers: that code is a backend transport with
+// its own framing and lifecycle, it is not exported (ggml/include/ggml-rpc.h exposes only
+// ggml_backend_rpc_add_server), and reaching into it would tie our protocol to an internal
+// boundary that upstream is free to move.
+//
+// Known limits of this layer (deliberate, documented rather than engineered around):
+//
+//  - The timeout is per read/write call, not per request and not per chain. A stage that keeps
+//    trickling bytes resets it every time, and a stage that answers slowly but steadily is not
+//    a timeout at all. It only catches "stopped answering altogether".
+//
+//  - It is set by the client (src/llama-split-remote.cpp, llama_split_remote::connect). The
+//    stage process does not bound its own blocking: if the driving server stops reading, the
+//    stage blocks in send() until the server's socket closes.
+//
+//  - A stalled chain is NOT visible through the *shallow* llama-server /health. That endpoint
+//    reports whether a model is loaded, not whether the chain is moving, and it must stay that
+//    way: it is what an orchestrator polls to decide whether a machine is alive, and answering
+//    "down" because one network stage had a bad second is how a healthy machine gets taken out
+//    of rotation. A caller that wants the chain itself must ask for it explicitly with
+//    /health?deep=1 (tools/server/server-context.cpp), which drives one real token through
+//    every stage and answers 503 when that cannot be done. A chain that already failed an
+//    operation is remembered (llama_memory_split::remote_failure) and refused without touching
+//    the network, so a deep probe cannot hang on it.
+//
+//    Do not poll deep=1. The probe is a real request: it runs with cache_prompt = false (so the
+//    slot cannot answer it from logits it already has), which makes the server clear that slot's
+//    KV and re-process the probe prompt. On a remote chain, whose head carries one sequence by
+//    construction, the next genuine request then has to re-process its prompt instead of reusing
+//    the cache. Poll the shallow /health; use deep=1 when a chain is already suspected, or once
+//    after a config change.
+#pragma once
+
+// LLAMA_API: the stage tool links against the library instead of carrying its own copy, so
+// these entry points have to be visible from the DLL. Same pattern as src/llama-ext.h.
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+
+#ifdef _WIN32
+#  ifndef NOMINMAX
+#    define NOMINMAX   // winsock2.h pulls in <windows.h>, whose min/max macros break std::min
+#  endif
+#  define WIN32_LEAN_AND_MEAN
+#  include <winsock2.h>
+#  include <ws2tcpip.h>
+#  pragma comment(lib, "ws2_32.lib")
+namespace qlh_split::net {
+using sock_t = SOCKET;
+constexpr sock_t invalid = INVALID_SOCKET;
+}
+#else
+#  include <arpa/inet.h>
+#  include <netinet/in.h>
+#  include <netinet/tcp.h>
+#  include <sys/socket.h>
+#  include <unistd.h>
+namespace qlh_split::net {
+using sock_t = int;
+constexpr sock_t invalid = -1;
+}
+#endif
+
+namespace qlh_split::net {
+
+// One-time process-wide socket setup. Safe to call more than once; on POSIX it is a no-op.
+LLAMA_API bool global_init();
+
+inline bool valid(sock_t s) { return s != invalid; }
+
+LLAMA_API void close_sock(sock_t s);
+
+// Both return false as soon as the peer stops cooperating. Partial transfers are retried;
+// a read/write that blocks longer than the socket's timeout (see set_timeout) counts as the
+// peer having stopped cooperating.
+LLAMA_API bool send_all(sock_t s, const void * src, size_t n);
+LLAMA_API bool recv_all(sock_t s, void * dst, size_t n);
+
+// [QLH-SPLIT] Send two buffers as ONE write (WSASend scatter/gather on Windows, writev on POSIX).
+//
+// The frame format is "fixed header + payload", and the two used to be two send() calls. Over
+// loopback that costs nothing, which is why it survived so long; over a real link it is the
+// Nagle/delayed-ACK trap. The kernel sees a 32 B write followed immediately by a second small
+// write: the first segment goes out alone, and Nagle holds the second one until the peer's
+// delayed ACK arrives. Measured on a cross-host chain: 48-52 ms between the header and the body
+// of the candidate reply (build-split/cand/events_9333.txt), i.e. half a token of latency added
+// to every token for a 320 B frame that should have cost microseconds.
+//
+// Scatter/gather instead of memcpy on purpose: the biggest payload on this wire is the 248k-entry
+// logits row (993 KB), and copying that once per token to make the write "contiguous" would cost
+// more than the syscall it saves. WSASend takes both buffers in one call and the kernel still
+// emits them as MSS-sized segments, so no user-space copy is needed.
+//
+// Retries partial sends, like send_all. Returns false when the peer stops cooperating.
+LLAMA_API bool send_two(sock_t s, const void * a, size_t na, const void * b, size_t nb);
+
+// [QLH-SPLIT] Turn off Nagle on one connection (TCP_NODELAY).
+//
+// Merging header+body (send_two) fixes the frame shapes this protocol actually sends, but it is
+// a per-call cure: any future small write that follows unacknowledged data pays the same 50 ms
+// again. TCP_NODELAY removes the wait wholesale, at the cost of letting the kernel send each
+// write as soon as it can instead of batching small ones. That trade is right here because
+// latency, not packet count, is what a chain of two machines spends its time on: every token
+// crosses the link twice, so the ACK delay is charged per token.
+//
+// Call it on both ends after connect/accept: Nagle delays the *sender*, so a one-sided setting
+// only removes half the problem. Returns false if the option could not be set.
+LLAMA_API bool set_nodelay(sock_t s);
+
+// [QLH-SPLIT] Bound how long one send/recv may block, in milliseconds (SO_RCVTIMEO/SO_SNDTIMEO).
+//
+// Without this a stage that stops answering -- suspended, killed without a FIN, a NIC that
+// disappeared -- pins the driving slot forever: there is no other timeout on this path, and
+// llama-server's /health only answers "is the model loaded", so the chain stops producing
+// tokens while every health check keeps returning 200. A finite timeout turns that into the
+// ordinary request failure it already knows how to report.
+//
+// Returns false if either option could not be set, which the caller should treat as "this
+// connection has no failure bound" rather than as a usable socket.
+LLAMA_API bool set_timeout(sock_t s, int ms);
+
+// [QLH-SPLIT] Connect with a bound, in milliseconds (0 keeps the ordinary blocking connect).
+//
+// A blocking connect() has no timeout of its own: on Windows it waits out the kernel's SYN
+// retries (~21 s) before answering WSAETIMEDOUT, and on a chain that is being rebuilt the caller
+// may have to try this on every request. That is the difference between "the stage is down, the
+// chain says so immediately" and "every request spends 21 s in connect() first", which is
+// exactly the behaviour the rebuild throttle exists to prevent.
+//
+// Non-blocking connect + select is the portable way to get a deadline. The socket is left in
+// blocking mode again on every path, so the caller can hand it straight to send_all/recv_all.
+LLAMA_API bool connect_timeout(sock_t s, const struct sockaddr * addr, int addrlen, int ms);
+
+} // namespace qlh_split::net
diff --git a/src/llama-split-proto.h b/src/llama-split-proto.h
new file mode 100644
index 000000000..5c71f1cd3
--- /dev/null
+++ b/src/llama-split-proto.h
@@ -0,0 +1,573 @@
+// [QLH-SPLIT] Wire protocol between stages of a split chain.
+//
+// The chain already has a clean seam: a stage takes hidden rows in and gives hidden rows (or
+// logits) out. This header is that seam on the wire -- nothing more.
+//
+// Framing is fixed-width and little-endian on both sides, with no negotiation: the two ends
+// are built from the same source tree, so version skew is not a supported state. A request
+// carries exactly one operation; a reply carries exactly its result. There is no pipelining and
+// no multiplexing, because decode_split drives the stages in order anyway.
+//
+// Every field is explicit about width rather than using `unsigned long` or `size_t`, so a
+// frame means the same thing on both ends of a connection.
+//
+// The ops are exactly the memory operations llama-server actually reaches on a chain (the
+// measurement that decided this is in llama-memory-split.h); there is nothing here for
+// seq_cp / seq_add / seq_keep / seq_div, which a serving path never calls.
+#pragma once
+
+#include <cstdint>
+
+namespace qlh_split {
+
+constexpr uint32_t MAGIC       = 0x514C4853; // 'QLHS'
+// Bumped whenever a frame layout or an op number changes. There is no negotiation, so this is
+// the only thing that turns "a stage from an older build" into a clean protocol error instead of
+// a misread reply header. v2: dropped the unused OP_POS and rsp_header::pos_max.
+// v3: added the state ops (llama_state_seq_*) and the n_bytes / pos_max header fields they use.
+// v4: added OP_HELLO, the identity handshake every connection now starts with, and made a HELLO
+//     the *first* frame a stage accepts. This has to be a version bump and not just a new op:
+//     a v3 stage would answer a v4 HELLO with "bad request" and a v3 client would never send one,
+//     so without the bump both sides would identify themselves only in the logs. With it, each
+//     end refuses the other on the first frame -- which is the correct outcome, because the
+//     identity check only means anything if the two ends were built together.
+// v5: added the candidate channel. A decode may now ask the tail for its top-k candidates
+//     (DECODE_FLAG_CANDIDATES) instead of the whole row of logits, and the reply says which of
+//     the two it carries (rsp_header::flags). This is a version bump rather than a flag-only
+//     change because a v4 tail would ignore the flag, read the extra request bytes as the next
+//     header, and desynchronize the connection -- the worst kind of skew, since it looks like a
+//     network fault.
+// v6: the state ops carry a *handle* instead of the blob (STATE_FLAG_HANDLE), and a stage may
+//     answer ST_STALE for a handle it no longer holds. Before this, every context checkpoint
+//     pulled the stage's whole recurrent state down the wire and pushed it back on restore:
+//     6,733,996 B for an 8-layer qwen35 tail, 13,172,908 B for the 8-layer qwen35moe tail, per
+//     checkpoint, and twice per request on the measured chat path. The stage already holds that
+//     state in its own memory, so the head only needs a *name* for it. A v5 stage would read the
+//     handle record as the first bytes of a blob and desynchronize the connection, which is why
+//     this is a version bump and not a flag-only change.
+// v7: the per-row verify channel (DECODE_FLAG_VERIFY_ROWS). A decode may ask the tail for one
+//     *token id* per batch row instead of one row of logits for the last row, which is what
+//     speculative verification needs: k drafts + 1 target row, each reduced to its argmax by the
+//     stage that already has the row in memory. The reply carries n_tokens * int32 (16 B for the
+//     default k = 3) instead of 993 KB of logits. Flag-only on both sides -- the frame layouts do
+//     not move -- but a v6 tail would *ignore* the flag and answer with the single logits row,
+//     and the head would then parse 993 KB as a token array. Refusing on the version is the same
+//     argument as v5: a silently misparsed reply is worse than a clean protocol error.
+// v8: the MTP draft channel (OP_MTP_DRAFT) and the h_nextn rows a decode can answer with
+//     (DECODE_FLAG_NEXTN_ROWS). The draft head lives in the tail segment -- it is a full
+//     transformer block appended after the trunk, so only the range that owns the model's last
+//     layer loads it -- and until now a remote chain could only draft with ngram, because the
+//     only way to run that head was a local context. v8 lets the head hand the tail one hidden
+//     row plus one token and get k draft tokens back, with the k-step recursion happening inside
+//     the stage (each step's input h is the previous step's output, so it cannot be batched).
+//     Two layout changes force the bump: OP_MTP_DRAFT is a new frame, and a decode reply that
+//     carries h_nextn rows appends n_rows * n_embd floats that a v7 head would read as the next
+//     reply's header. stage_id also gains has_nextn in a byte that was padding, which is why a
+//     v8 stage and a v7 head must refuse each other rather than trade a 28-byte struct with a
+//     different meaning.
+// v9: the layer-input tap channel (DECODE_FLAG_LAYER_INP). DFlash and DSpark draft by injecting the
+//     *input* row of a set of trunk layers (dflash.target_layers) into the draft model's KV cache.
+//     In a split chain the upper taps are computed by the tail, so the head cannot read them at all
+//     -- which is what kept both drafters local-only, while the measured loss of the alternative
+//     (MTP over a chain: -24.4% acceptance) says they are worth having remotely. A decode can now
+//     name *source-model* layer ids and get back the rows of the ids each stage owns.
+//     Layout changes: the request grows a layer_inp_req block when the flag is set, a reply that
+//     carried taps appends n_taps ids plus n_rows * n_taps * n_embd floats, and rsp_header names the
+//     answered tap count in a byte that was padding. A v8 head would read the ids as the next
+//     reply's header, so this is a version bump and not a flag-only change.
+constexpr uint32_t PROTO_VER   = 9;
+constexpr uint32_t MAX_TOKENS  = 65536;      // per frame; guards against a corrupt length
+constexpr uint32_t MAX_EMBD    = 65536;      // widest hidden row we accept
+constexpr uint32_t MAX_STATE   = 1u << 30;   // largest sequence state we accept (1 GiB)
+
+// [QLH-SPLIT] v7: the most result rows a tail answers in one per-row verify frame.
+//
+// This is a *shared constant*, not a stage command-line option, because the head has to know it
+// before it asks: a tail is built with n_outputs_max rows of logits and a frame that asks for
+// more is refused. Both ends come from the same source tree (that is what PROTO_VER means), so
+// one number here is enough -- the same argument this file already makes for every other
+// capacity it pins.
+//
+// A speculative round verifies n_draft + 1 rows (the sampled token plus every draft). The default
+// draft block is 3 (common_params_speculative_draft::n_max), and the server caps a remote chain's
+// draft block at MAX_VERIFY_ROWS - 1 (tools/server/server-context.cpp, get_n_draft_max), so a
+// request that asks for more is shortened, never silently truncated on the wire.
+//
+// The cost is on the tail's side only: n_outputs_max bounds the logits node the *reserve* pass
+// allocates, so the stage holds MAX_VERIFY_ROWS * n_vocab * 4 B of compute buffer -- 16.9 MB for
+// the 248k-vocabulary model this fork ships, against 3.3 GB at -b 2048. Paying that once at
+// startup is what makes a verify frame possible at all; paying it per frame would be the bug.
+constexpr uint32_t MAX_VERIFY_ROWS = 17;
+
+// [QLH-SPLIT] v8: the most draft tokens one OP_MTP_DRAFT may ask for.
+//
+// Not a tuning knob: it is MAX_VERIFY_ROWS - 1, i.e. the number of drafts a verify frame can
+// carry. A round that asked for more could not be verified, so the cap is the same number the
+// draft block is capped by (tools/server/server-context.cpp, get_n_draft_max) and both ends read
+// it from here rather than inventing a second limit.
+constexpr uint32_t MAX_MTP_DRAFT = MAX_VERIFY_ROWS - 1;
+
+// [QLH-SPLIT] v9: the most layer-input taps one decode frame may ask for.
+//
+// A property of the draft model, not a tuning knob: DFlash names 8 trunk layers and DSpark 5, and a
+// frame that asked for more would be answered with more rows per batch row than any draft consumes.
+// The cap exists so a corrupt or hostile n_taps cannot turn into a huge allocation in a stage; the
+// real value is attached to the model (dflash.target_layers), and both ends read the cap from here.
+constexpr uint32_t MAX_LAYER_INP_TAPS = 16;
+
+enum op : uint8_t {
+    OP_DECODE     = 1,   // hidden in, hidden or logits out; the data path of llama_decode
+    OP_SEQ_RM     = 2,   // llama_memory_i::seq_rm -- the only mutation llama-server performs per request
+    OP_CLEAR      = 3,   // llama_memory_i::clear -- warmup and the server's seq_rm capability probe
+    // [QLH-SPLIT] v6: the state ops. With STATE_FLAG_HANDLE (see below) OP_STATE_SAVE asks the
+    // stage to keep the snapshot and answer with its handle, and OP_STATE_LOAD names one instead
+    // of carrying the bytes; without it they still move the blob itself, which is what a slot
+    // file written by a pre-v6 build contains.
+    OP_STATE_SAVE = 4,   // llama_state_seq_get_size / get_data: fetch (or just measure) a state blob
+    OP_STATE_LOAD = 5,   // llama_state_seq_set_data: push a state blob back
+    OP_BYE        = 6,   // clean shutdown, so a closing chain does not look like a broken pipe
+    // [QLH-SPLIT] v4: identity handshake. The first frame on every connection, request and reply.
+    // See stage_id below for what it carries and why these fields and not a model hash.
+    OP_HELLO      = 7,
+    // [QLH-SPLIT] v8: draft k tokens with the MTP head this stage owns. See mtp_req for the
+    // request body and the note there for why one frame can carry a whole draft block.
+    OP_MTP_DRAFT  = 8,
+};
+
+// Which end of a chain a stage serves. It is part of the identity, not a tuning flag: the stage
+// decides from its own role whether a decode answers with hidden rows or logits, so a tail in a
+// relay position (or a relay in the tail position) hands the next stage a vector it cannot use.
+// reconnecting does not change the role, so it is compared like every other field.
+enum role : uint8_t {
+    ROLE_ANY   = 0, // in a HELLO request: this position does not pin the role (never sent as a stage's own role)
+    ROLE_RELAY = 1,
+    ROLE_TAIL  = 2,
+};
+
+// Sentinel for "this field is not pinned" in a HELLO *request*. Only the layer_hi of a stage that
+// is not the chain's last one is unknown before that stage answers: it is whatever the next stage
+// starts at, so this side learns it from this stage's own reply. Every other field is known from
+// the head's model, and a reconnect() pins all of them (it compares against the identity it
+// confirmed at attach time).
+constexpr int32_t ID_ANY_I32 = -1; // no real layer / layer count is negative
+
+// [QLH-SPLIT] Identity of one stage: what a HELLO request asks for, what a HELLO reply reports.
+//
+// Why a handshake exists at all: reconnecting a stage that was restarted is now routine (the
+// chain rebuilds itself on the next request from position 0), and a plain TCP reconnect says
+// nothing about *which* stage answered. A stage restarted with a different --layer-range, a
+// different model, or a different trunk depth produces plausible-but-wrong tokens from the first
+// frame, with no error anywhere -- the exact class of failure this layer exists to make
+// impossible.
+//
+// Why exactly these fields, and not a hash of the model file:
+//  - layer_lo / layer_hi: the range this stage computes. Two stages with different ranges feed
+//    the same hidden row through different layers, so every later token is wrong while the wire
+//    stays perfectly well formed.
+//  - n_layer_src: the trunk depth of the source model, i.e. what those layer numbers are
+//    relative to. [16, 24) of a 24-layer model and [16, 24) of a 32-layer model are different
+//    stages, and layer_lo/layer_hi alone cannot tell them apart.
+//  - n_embd_inp / n_embd_out: the width of the hidden row the stage consumes and produces.
+//    A hop carries exactly one width and the chain already validates it, but only after the
+//    stage has been handed a decode; checking it at connect time is what makes a wrong model
+//    fail at attach instead of mid-request. The two are separate fields because a stage that
+//    could not carry one width is refused at startup -- seeing the disagreement here is how the
+//    head notices it is not talking to a stage built from the same model.
+//  - n_vocab: only the tail uses it (it is the logits dimension), but every stage carries it.
+//    It is one more number a different model cannot accidentally share, and it makes "same
+//    architecture, same width, different model" visible where the other fields agree.
+//  - role: relay vs tail, as above.
+//
+// [QLH-SPLIT] v8 adds one field, and it is the first thing in this protocol that answers "what can
+// you *do*" instead of "who are you": has_nextn says whether this stage holds a working MTP draft
+// context. Unlike every other field it is deliberately *not* compared, because the chain does not
+// require it to match -- a tail whose MTP context failed to build is still the right tail, and the
+// only consequence is that the head does not speculate (see OP_MTP_DRAFT). It rides in a byte that
+// was padding, so the struct keeps its size; that is not a compatibility argument (PROTO_VER
+// covers that) but it does keep the frame layout the same shape it has always had.
+//
+// A full model hash is deliberately not used: it would read hundreds of MB on every reconnect
+// (the chain rebuilds on the request path) to answer "is this the same file", while a stage
+// restarted with a different --layer-range of the *same* file is already a different stage. These
+// fields are the numbers the computation actually depends on; anything else is a proxy that
+// costs much more and discriminates less.
+//
+// The numbers are also not a security boundary: the protocol has no authentication, and --host
+// exists for a stage reached over an internal network or a tunnel. This identifies a stage, it
+// does not authorize one.
+struct stage_id {
+    int32_t  layer_lo;
+    int32_t  layer_hi;
+    int32_t  n_layer_src;
+    uint32_t n_embd_inp;
+    uint32_t n_embd_out;
+    uint32_t n_vocab;
+    uint8_t  role;
+    // [QLH-SPLIT] v8: non-zero when this stage can answer OP_MTP_DRAFT, i.e. it owns a NextN/MTP
+    // block and built a draft context over it. 0 for a relay, for a tail range that does not end at
+    // the model's last layer, and for a model without NextN layers.
+    uint8_t  has_nextn;
+    uint8_t  _pad[2];
+};
+
+static_assert(sizeof(stage_id) == 28, "stage_id is a wire structure; keep its size explicit");
+
+// req_header::flags for the state ops: the low bits are llama_state_seq_flags (PARTIAL_ONLY = 1,
+// ON_DEVICE = 2), the top bit asks OP_STATE_SAVE for the size and the position only. One op for
+// both because the size query and the fetch are always issued back to back, and the reply header
+// already carries what the query needs.
+constexpr uint8_t STATE_FLAG_SIZE_ONLY = 0x80;
+
+// [QLH-SPLIT] v6, req_header::flags for the state ops: "keep this snapshot yourself and tell me
+// its name" / "restore the snapshot this name refers to".
+//
+// Why a handle at all: a checkpoint of a split chain is the head's state plus every stage's, and
+// the stage's part is the recurrent state -- 6.7 MiB for an 8-layer qwen35 tail, 12.56 MiB for
+// the same 8 layers of the 35B qwen35moe. The head never reads those bytes: it stores them and
+// hands them back unchanged. Measured on a real link, that round trip was 0.8-1.2 s per
+// checkpoint at 16 MB/s and 2.8 s at the 5 MB/s the field report was taken on -- more than the
+// decode it was protecting. A stage asked to *keep* the snapshot instead transfers 8 bytes down
+// and 8 bytes back, and the restore is a memcpy inside the process that already had the state.
+//
+// The handle is opaque to the head. It names a snapshot in the stage's own cache, is valid only
+// for that stage *process*, and expires when the cache evicts it (ST_STALE, see status). Nothing
+// about it is stable across a stage restart, which is exactly why an expired handle must be a
+// recoverable answer and not a broken chain: the stage refuses before applying anything, so the
+// chain is exactly where it was and the caller can re-process the prompt instead of restoring.
+constexpr uint8_t STATE_FLAG_HANDLE = 0x40;
+
+// The size of the record the head stores per remote stage in the v6 layout: {int32 pos_max,
+// uint32 n_bytes, uint64 handle}. Named so both ends and the state layout comment agree.
+constexpr uint32_t STATE_HANDLE_BYTES = sizeof(uint64_t);
+
+// [QLH-SPLIT] v5, req_header::flags for OP_DECODE: "answer with the top-k candidates, not the
+// whole row of logits".
+//
+// Why the candidates and not the row: the tail's logits row is n_vocab f32 (248 KB for the 2B
+// model here, 993 KB over the wire with framing and the rest of the frame), and it is returned
+// for every decoded token. On a 16 MB/s link that is ~59 ms per token, which is most of the
+// difference between a cross-machine chain and a whole model (build-split/xhost/REPORT.md).
+// The sampling chain truncates to k tokens in its `top_k` step anyway, and every step after
+// top_k only ever looks at those k entries -- so the k (id, logit) pairs are exactly as good an
+// input for the rest of the chain as the full row, at 8 bytes each. See cand_req for what the
+// tail needs to reproduce the steps *before* top_k, and llama-split-remote.h for the fallback
+// rule that keeps this flag off whenever the k candidates are not a faithful substitute.
+//
+// Bit 0 is free for OP_DECODE because the only other flags in this header are the state-op ones
+// above, and the two ops never share a frame.
+constexpr uint8_t DECODE_FLAG_CANDIDATES = 0x01;
+
+// [QLH-SPLIT] v7, req_header::flags for OP_DECODE: "answer with one token id per batch row".
+//
+// Why a second flag and not the candidate channel with top_k == 1: the two answer different
+// questions. The candidate channel replaces the *sampler* for one row (the tail runs the steps up
+// to top_k and this side runs the rest), so it must know the chain's sampling parameters. This
+// one replaces the *verification* of k + 1 rows: the head already decided that every row is read
+// through a greedy sampler (common_sampler_verify_rows_check), and under argmax the answer for a
+// row is just its token id -- no chain, no parameters, 4 bytes.
+//
+// Mutually exclusive with DECODE_FLAG_CANDIDATES; a frame that sets both is refused.
+constexpr uint8_t DECODE_FLAG_VERIFY_ROWS = 0x02;
+
+// [QLH-SPLIT] v8, req_header::flags for OP_DECODE: "also answer the h_nextn rows of the rows you
+// marked as output".
+//
+// Why the tail has to send them at all: the MTP draft's input is t_h_nextn = RMSNorm(last trunk
+// layer output), and in a split chain that last layer runs in the tail, so the head cannot compute
+// the row it must hand to the next OP_MTP_DRAFT. It is not a speculative extra either: the row of
+// the *accepted* position is the input of the next draft round, and the row of the last token of a
+// plain decode is the input of the round after that.
+//
+// Which rows: exactly the ones the reply already answers for -- all of them for a verify frame,
+// the last one for a plain tail decode (see batch.logits in tools/split-stage/main.cpp). That is
+// what keeps a prefill from shipping n_tokens * n_embd floats: a prefill frame marks one output
+// row, so it carries one h row (16 KB at n_embd 4096), not the whole prompt's worth.
+//
+// Eligible in the same frame as either output channel: the draft needs this row *while* it reads
+// per-row tokens or candidates, so forbidding the combination would mean asking the tail the same
+// question twice.
+//
+// A stage that cannot produce the rows ignores the flag rather than refusing the frame: the reply
+// then has the v7 shape, which the head still parses (it reads the rows because of the *reply*
+// flag, never because it asked), so a tail that lost its MTP context degrades to "no drafts"
+// instead of failing the request.
+constexpr uint8_t DECODE_FLAG_NEXTN_ROWS = 0x04;
+
+// [QLH-SPLIT] v9, req_header::flags for OP_DECODE: "also answer the layer-input rows of these
+// layers".
+//
+// Why a stage has to send them: DFlash and DSpark draft by injecting the *input row* of a set of
+// trunk layers (dflash.target_layers -- 8 for DFlash, 5 for DSpark) into the draft model's KV cache,
+// one row per batch position. That row is the hidden state entering layer il, so layer il has to run
+// where it is read; in a split chain the upper taps run in the tail, and the head cannot reconstruct
+// them from what the chain hands back (that is the last layer's output, not any layer's input). The
+// local chain reads them straight out of the tail context's buffer (common/speculative.cpp,
+// tap_ctx/tap_lid, zero bytes on the wire); a remote chain needs them here.
+//
+// Which ids: *source-model* layer ids, not stage-local ones. Every stage that receives the request
+// answers the ids inside its own [layer_lo, layer_hi) and skips the rest, so the head needs to know
+// nothing about where the chain was cut -- and a three-stage chain, where a middle relay owns some of
+// the taps, works without any extra mapping. The answered ids travel back in the reply, which is what
+// lets a stage answer a subset without either side guessing.
+//
+// Which rows: all of them, always. That is where this channel differs from the h_nextn one above: the
+// draft injects *every* position of the frame into its KV, so a verify frame needs k + 1 rows and a
+// prefill frame needs the whole ubatch. A prefill is therefore where the channel actually costs
+// something (n_ubatch * n_taps * n_embd), not the k-row verify frame.
+//
+// Orthogonal to all three output channels: the rows are appended last (see RSP_FLAG_LAYER_INP).
+constexpr uint8_t DECODE_FLAG_LAYER_INP = 0x08;
+
+// [QLH-SPLIT] v5, rsp_header::flags: the reply to an OP_DECODE that carried
+// DECODE_FLAG_CANDIDATES. The body is n_bytes worth of (int32 id, float logit) pairs, sorted by
+// descending logit -- the same order and the same logit values llama_sampler_apply() leaves in
+// cur_p after its top_k step. n_vocab is 0 in this reply: the whole row was *not* sent, so a
+// caller that needs it (pre-sampling logprobs, grammar) must have asked for it up front. That
+// decision belongs to the driving side and is made before the request starts, never inferred
+// from a reply (see llama-split-remote.h).
+constexpr uint8_t RSP_FLAG_CANDIDATES = 0x01;
+
+// [QLH-SPLIT] v7, rsp_header::flags: the reply to an OP_DECODE that carried
+// DECODE_FLAG_VERIFY_ROWS. n_tokens is the row count of the frame that was decoded, n_embd and
+// n_vocab are 0, and the body is n_bytes worth of int32 token ids in batch row order --
+// row i's entry is the argmax of row i's logits, i.e. exactly the token a greedy chain
+// (llama_sampler_init_greedy, or temp 0) would have selected from that row.
+//
+// Ties resolve to the lowest token id, which is what the greedy sampler does as well
+// (src/llama-sampler.cpp, llama_sampler_greedy_apply: only a strictly greater logit moves the
+// selection).
+constexpr uint8_t RSP_FLAG_VERIFY_ROWS = 0x02;
+
+// [QLH-SPLIT] v8, rsp_header::flags: the reply to an OP_DECODE that carried
+// DECODE_FLAG_NEXTN_ROWS. n_embd is the width of those rows (not 0, unlike the other two channel
+// replies), and the body appends n_rows * n_embd f32 to whatever the reply already carries, in
+// this order: the per-row token ids (if RSP_FLAG_VERIFY_ROWS), then the h_nextn rows, then the
+// candidate pairs (if RSP_FLAG_CANDIDATES) or the logits row. n_rows is n_tokens for a verify
+// frame and 1 otherwise -- the stage decides from the batch it built, and the head knows which of
+// the two it asked for, so the count is never inferred from the byte length.
+//
+// They are raw f32, the same representation the local chain reads out of its tail context: this is
+// the MTP head's input, and quantizing or truncating it would change the draft tokens, which is
+// exactly what the draft/verify comparison in build-split/verify_mtp.sh is there to catch.
+constexpr uint8_t RSP_FLAG_NEXTN_ROWS = 0x04;
+
+// [QLH-SPLIT] v9, rsp_header::flags: the reply to an OP_DECODE that carried DECODE_FLAG_LAYER_INP and
+// that this stage owns at least one of the named layers to answer for.
+//
+// rsp_header::n_taps is the number of ids answered, n_embd their width, and the body ends with those
+// n_taps int32 source-layer ids followed by n_rows * n_taps * n_embd f32: the first tap's row for
+// batch row 0, the second tap's row for row 0, ..., then row 1. n_rows is the frame's own row count,
+// which the head knows because it sent the frame; a stage that answered another count is caught by
+// n_bytes, so no count is ever inferred from a byte length.
+//
+// The tap section is the *last* section of every reply, after the per-row ids, the h_nextn rows and
+// the candidates or logits row. That keeps the head's parse of the answer it asked for identical to
+// v8 and puts the taps behind it, one block, once per frame.
+//
+// n_taps = 0 with the flag clear is the answer of a stage that owns none of the named layers: it
+// ignores the request instead of refusing the frame, the same way a stage without a NextN block
+// ignores DECODE_FLAG_NEXTN_ROWS. A missing tap degrades one request's drafts; refusing the frame
+// would fail it, and a draft is an optimization (llama-ext.h).
+constexpr uint8_t RSP_FLAG_LAYER_INP = 0x08;
+
+// [QLH-SPLIT] v8: the body of OP_MTP_DRAFT.
+//
+// One frame carries a whole draft block, and that is the point: the k drafts are recursive (draft
+// i's input h is draft i-1's output h_nextn), so they cannot be batched, but the *round trip* can
+// be one. The tail runs the k internal decodes and answers k token ids; a per-token op would put
+// k extra round trips on the request path, which on the measured 18-22 ms hop is the whole win.
+//
+// The two scalars are the local chain's draft loop, unchanged (common/speculative.cpp,
+// common_speculative_impl_draft_mtp::draft, the non-chain_heads branch): step i decodes the token
+// at position pos + i, with the h row the previous step produced, and step 0 uses `hidden` -- the
+// h_nextn row of position pos - 1 -- together with `token`, the token at `pos`.
+//
+// Drafting is greedy here on purpose. The local implementation's draft sampler is top_k = 10 and it
+// takes cur_p->data[0], i.e. the argmax, so the tail answering the argmax of each of its own rows
+// produces the same tokens; and the verify channel this feeds is only armed for a greedy chain in
+// the first place (common_sampler_verify_rows_check), where argmax *is* the answer. A probabilistic
+// drafter would need q over the full vocabulary to cross the wire, which is the cost this whole
+// layer exists to avoid.
+struct mtp_req {
+    int32_t  token;  // the token at `pos` (the last accepted or sampled one)
+    int32_t  pos;    // its position; draft i is decoded at pos + i
+    uint32_t k;      // drafts to return, 1..MAX_MTP_DRAFT
+    uint32_t _pad;
+};
+
+static_assert(sizeof(mtp_req) == 16, "mtp_req is a wire structure; keep its size explicit");
+
+// [QLH-SPLIT] v9: the body section a DECODE_FLAG_LAYER_INP frame appends after everything else in the
+// frame -- this fixed part, then n_taps int32 source-layer ids.
+//
+// Variable length rather than a fixed array: the tap list belongs to the draft model, not to this
+// protocol, so a model with more taps must not need a protocol change, and a fixed array sized for
+// the largest one would put its width in every frame for every chain.
+//
+// n_embd is here so a stage can refuse a frame from a different model up front, with a number in the
+// message, instead of shipping a block whose stride nobody agrees on. It is the *trunk* width, not the
+// hidden-row width the header carries: those are equal in every split chain this tree builds
+// (llama_split_attach refuses a chain where they differ), but the tap row is the layer input, which
+// is always the trunk width (src/llama-context.cpp, extract_layer_inputs).
+struct layer_inp_req {
+    uint32_t n_taps; // ids that follow; 1..MAX_LAYER_INP_TAPS
+    uint32_t n_embd; // width of one tap row
+    uint32_t _pad[2];
+};
+
+static_assert(sizeof(layer_inp_req) == 16, "layer_inp_req is a wire structure; keep its size explicit");
+
+// [QLH-SPLIT] v5: the steps a tail must run before it can answer with candidates, in the order
+// they appear in the driving side's sampler chain. Only the samplers that have to see the whole
+// vocabulary are in here; everything after top_k runs on the candidates, on the side that has
+// the rest of the chain.
+//
+// The tail cannot take a common_sampler: tools/split-stage links `llama` and not `common`, so it
+// has only llama.h's C API. That is enough -- these three are exactly the steps top_k needs to
+// be exact.
+enum cand_step : uint8_t {
+    CAND_STEP_PENALTIES   = 1, // llama_sampler_init_penalties; needs the recent token history
+    CAND_STEP_TOP_N_SIGMA = 2, // llama_sampler_init_top_n_sigma; needs the whole row's mean/std
+    CAND_STEP_TOP_K       = 3, // llama_sampler_init_top_k; always last
+};
+
+// [QLH-SPLIT] v5: what the tail must know to reproduce the steps up to and including top_k.
+//
+// Penalties are here because they run *before* top_k: a penalty raises or lowers logits across
+// the whole vocabulary, so the top-k set of the penalized row is not the top-k set of the raw
+// row. Applying them on the candidate set afterwards would be both late (the k set could already
+// be wrong) and wrong (a token outside the k set can never come back). logit_bias is the same
+// case, which is why it travels too -- see the layout note in req_header.
+//
+// The history is a window, not an increment. The tail rebuilds the penalty state from scratch on
+// every frame (reset, then accept the window oldest-first), so a reconnected tail, a stage that
+// was restarted, a seq_rm and a state restore all converge to the same answer without any
+// bookkeeping on the wire. An increment would be smaller (4 bytes per token instead of a 64-token
+// window per frame) and would silently diverge the first time the two ends disagree about which
+// tokens were accepted -- exactly the failure this layer exists to make impossible. 64 tokens is
+// 256 bytes per frame against 320 for the candidates themselves; there is nothing to save.
+struct cand_req {
+    int32_t  top_k;              // candidates to return (the chain's top_k)
+    float    top_n_sigma;        // < 0: the chain has no top_n_sigma step to run here
+    int32_t  penalty_last_n;     // 0 disables the penalties step
+    float    penalty_repeat;
+    float    penalty_freq;
+    float    penalty_present;
+    uint32_t n_bias;             // logit biases that follow: n_bias * {int32 id, float bias}
+    uint32_t n_hist;             // then n_hist * int32 token, oldest first
+    uint8_t  n_steps;            // steps below actually present, in order
+    uint8_t  steps[3];           // cand_step values
+    uint8_t  _pad[2];
+};
+
+static_assert(sizeof(cand_req) == 40, "cand_req is a wire structure; keep its size explicit");
+
+// The candidate pairs themselves. Interleaved rather than two arrays: they are produced and
+// consumed together, and one array is one recv.
+struct token_cand {
+    int32_t id;
+    float   logit;
+};
+
+static_assert(sizeof(token_cand) == 8, "token_cand is a wire structure; keep its size explicit");
+
+enum status : uint8_t {
+    ST_OK       = 0,
+    ST_NO_SPACE = 1,  // maps to llama_decode's "1 = retry with a smaller batch"
+    ST_BAD_REQ  = 2,  // maps to -1
+    ST_INTERNAL = 3,  // maps to -3
+    // [QLH-SPLIT] v6: the handle names a snapshot this stage no longer holds -- its snapshot
+    // cache evicted it, or this process is not the one that minted it. Nothing was applied, so
+    // the chain is exactly where it was before the restore: the head answers "no checkpoint"
+    // (re-process the prompt) instead of declaring the chain dead. See STATE_FLAG_HANDLE.
+    ST_STALE    = 4,
+    // [QLH-SPLIT] v8: this stage cannot draft. Either it never had a NextN/MTP block, its MTP
+    // context failed to build at startup, or the range it serves does not end at the model's last
+    // layer. Nothing was decoded and nothing moved, so the head answers "this request does not
+    // speculate" and keeps serving: a chain whose fast path is unavailable is still a correct
+    // chain, which is the whole error policy of this layer.
+    ST_UNSUPPORTED = 5,
+};
+
+// A request is: header, then (n_tokens * n_pos * 4 bytes of positions), then
+// (n_tokens * n_embd * 4 bytes of hidden), for OP_DECODE; for OP_STATE_LOAD the header is
+// followed by n_bytes of state blob, and for the other ops it is the whole frame.
+//
+// [QLH-SPLIT] v5: an OP_DECODE that sets DECODE_FLAG_CANDIDATES follows the hidden rows with one
+// cand_req, then n_bias * {int32 id, float bias}, then n_hist * int32 token. Every section is
+// self-describing, so a tail reads exactly what the previous one told it to; a v4 tail rejects
+// the frame on the version check instead of parsing the candidate block as the next header.
+//
+// [QLH-SPLIT] v7: an OP_DECODE that sets DECODE_FLAG_VERIFY_ROWS adds nothing to the frame. The
+// rows are already described by n_tokens / n_embd / n_pos, and the rows the answer must cover are
+// all of them -- that is the whole point of the flag, so there is nothing to negotiate.
+//
+// [QLH-SPLIT] v8: an OP_DECODE that sets DECODE_FLAG_NEXTN_ROWS also adds nothing to the frame --
+// the rows it asks about are the ones the frame already describes. Only the reply grows, by
+// n_rows * n_embd floats (see RSP_FLAG_NEXTN_ROWS).
+//
+// [QLH-SPLIT] v9: an OP_DECODE that sets DECODE_FLAG_LAYER_INP appends one layer_inp_req and then its
+// n_taps int32 layer ids, after the candidate block when both are present. The ids are source-model
+// layer numbers; a stage answers the ones inside its own range and skips the rest, so one frame can be
+// sent to every stage of a chain without this side knowing where the cuts are.
+//
+// OP_MTP_DRAFT is header, then one mtp_req, then n_embd floats (one hidden row). The reply is the
+// header and k int32 token ids, n_bytes = k * 4. n_embd is the width of the hidden row, n_tokens
+// is 1, n_pos is 1 and seq_id is the sequence the draft belongs to; the draft context inside the
+// stage is per sequence, so a frame that named a different sequence would draft over another
+// request's KV.
+//
+// OP_HELLO is the one exception to "the header is the whole frame": it is followed by exactly
+// one stage_id (the caller's expectations), and its reply is followed by the stage's own
+// stage_id. Those two payloads are the reason this op exists; putting them here rather than in
+// every header keeps the per-frame cost and the existing frame layouts untouched -- identity is
+// established once per connection, not certified per decode.
+// Positions are section-major -- pos[j * n_tokens + i] is M-RoPE section j of token i -- which
+// is the layout llama_batch uses, and n_pos is on the wire so that a stage built for a different
+// model rejects the frame instead of reading it at the wrong stride.
+// What comes back is decided by the stage's role (relay or tail) and, for a tail, by
+// DECODE_FLAG_CANDIDATES / DECODE_FLAG_VERIFY_ROWS: a relay answers hidden, a tail answers either
+// the whole logits row, n_bytes/8 candidates (see RSP_FLAG_CANDIDATES) or n_tokens int32 token
+// ids (see RSP_FLAG_VERIFY_ROWS). DECODE_FLAG_NEXTN_ROWS is orthogonal to all three: it appends
+// the h_nextn rows, in the order documented on RSP_FLAG_NEXTN_ROWS. DECODE_FLAG_LAYER_INP is
+// orthogonal to all four, including a relay's hidden rows: the tap ids and rows are the last two
+// sections of the reply (see RSP_FLAG_LAYER_INP).
+struct req_header {
+    uint32_t magic;
+    uint32_t version;
+    uint8_t  op;
+    uint8_t  flags;
+    uint16_t _pad;
+    uint32_t n_tokens;
+    uint32_t n_embd;
+    uint32_t n_pos;     // positions per token (llama_hparams::n_pos_per_embd)
+    int32_t  seq_id;
+    int32_t  pos0;
+    int32_t  pos1;
+    uint32_t n_bytes;   // OP_STATE_LOAD: state bytes that follow; OP_HELLO: one stage_id follows
+};
+
+struct rsp_header {
+    uint32_t magic;
+    uint32_t version;
+    uint8_t  status;
+    uint8_t  flags;     // [QLH-SPLIT] v5: RSP_FLAG_*; was padding before, so the size is unchanged
+    // [QLH-SPLIT] v9: layer-input taps this reply answers (RSP_FLAG_LAYER_INP), else 0. It rides in a
+    // byte that was padding, which is not a compatibility argument (PROTO_VER covers that) but keeps
+    // the frame the shape it has always had -- the same trade stage_id::has_nextn makes.
+    uint8_t  n_taps;
+    uint8_t  _pad;
+    uint32_t n_tokens;
+    uint32_t n_embd;    // of the returned rows; 0 when returning logits
+    uint32_t n_vocab;   // set when status is OK and the whole logits row follows
+    int32_t  pos_max;   // OP_STATE_SAVE/LOAD: the stage's seq_pos_max at the time of the call
+    uint32_t n_bytes;   // OP_STATE_SAVE: state bytes that follow; OP_HELLO: sizeof(stage_id);
+                        // OP_DECODE with RSP_FLAG_CANDIDATES: n_cand * sizeof(token_cand)
+                        // OP_DECODE with RSP_FLAG_VERIFY_ROWS: n_tokens * sizeof(int32_t)
+                        // OP_DECODE with RSP_FLAG_LAYER_INP: everything above plus
+                        //   n_taps * 4 + n_rows * n_taps * n_embd * 4
+};
+
+static_assert(sizeof(rsp_header) == 32, "rsp_header is a wire structure; keep its size explicit");
+
+} // namespace qlh_split
diff --git a/src/llama-split-remote.cpp b/src/llama-split-remote.cpp
new file mode 100644
index 000000000..d904ac36e
--- /dev/null
+++ b/src/llama-split-remote.cpp
@@ -0,0 +1,1079 @@
+// [QLH-SPLIT] See llama-split-remote.h for the error policy this implements.
+#include "llama-split-remote.h"
+
+#include "llama-split-net.h"
+#include "llama-split-proto.h"
+
+#include <cstdio>
+#include <cstring>
+
+using namespace qlh_split;
+
+namespace {
+
+// [QLH-SPLIT] The data-path read timeout, unchanged from when it was a local constant inside
+// connect(): far above any honest stage latency (one -ubatch of prefill on CPU), finite only so a
+// stage that stops answering becomes a failed request instead of a pinned slot.
+constexpr int kStageTimeoutMs = 120 * 1000;
+
+// [QLH-SPLIT] Budget for one rebuild handshake (connect, then the clear that follows it).
+//
+// Deliberately not the data-path timeout. The rebuild runs on a request thread, often for a chain
+// that is still down, and its whole job is to answer "is this stage back?" -- a question a healthy
+// stage answers in microseconds and a suspended one never answers at all. A stage that has been
+// suspended still completes the TCP handshake out of its listen backlog, so the connect succeeds
+// and it is the clear() that hangs; bounding it here is what keeps one request from paying the
+// full 120 s while the throttle keeps the next five from even trying.
+constexpr int kRebuildTimeoutMs = 1500;
+
+// "host:port", and nothing more elaborate: the endpoint syntax has to stay obvious because it
+// appears in command lines.
+bool parse_endpoint(const std::string & ep, std::string & host, uint16_t & port) {
+    const size_t colon = ep.rfind(':');
+    if (colon == std::string::npos || colon == 0 || colon + 1 >= ep.size()) {
+        return false;
+    }
+    host = ep.substr(0, colon);
+    try {
+        const int p = std::stoi(ep.substr(colon + 1));
+        if (p <= 0 || p > 65535) {
+            return false;
+        }
+        port = (uint16_t) p;
+    } catch (...) {
+        return false;
+    }
+    return true;
+}
+
+// [QLH-SPLIT] The reply header is checked on every operation; keeping the two failure messages in
+// one place is what keeps them from drifting. The version check in particular used to say
+// "bad reply header", which an operator reads as "the network is flaky": the actual cause is
+// always that one end was built from a different source tree, and saying so is the whole point
+// of refusing to serve in that state.
+bool check_reply_header(const rsp_header & rsp, std::string & err) {
+    if (rsp.magic != MAGIC) {
+        err = "the peer is not speaking the split-stage protocol (reply magic " +
+              std::to_string((unsigned) rsp.magic) + ", expected " + std::to_string((unsigned) MAGIC) +
+              "); check the endpoint and port";
+        return false;
+    }
+    if (rsp.version != PROTO_VER) {
+        err = "protocol version mismatch: this build speaks v" + std::to_string((unsigned) PROTO_VER) +
+              ", the peer answered v" + std::to_string((unsigned) rsp.version) +
+              ". Both ends must be built from the same source tree (rebuild llama-server and "
+              "split-stage together); this is not a network problem";
+        return false;
+    }
+    return true;
+}
+
+const char * role_name(uint8_t r) {
+    switch (r) {
+        case ROLE_RELAY: return "relay";
+        case ROLE_TAIL:  return "tail";
+        default:         return "unknown";
+    }
+}
+
+// What the stage says it is. Printed next to the expectation in a mismatch message, so an
+// operator can compare the two ranges without looking up anything else.
+std::string describe_identity(const stage_id & id) {
+    return "layers [" + std::to_string(id.layer_lo) + ", " + std::to_string(id.layer_hi) + ") of a " +
+           std::to_string(id.n_layer_src) + "-layer model (n_embd_inp " +
+           std::to_string(id.n_embd_inp) + ", n_embd_out " + std::to_string(id.n_embd_out) +
+           ", n_vocab " + std::to_string(id.n_vocab) + ", role " + role_name(id.role) + ")";
+}
+
+// What this position in the chain must be. `layer_hi` may be unknown for a stage that is not the
+// chain's last one (see stage_id); that is shown as '?' rather than as a number, so the message
+// does not claim to know something it does not.
+std::string describe_expect(const stage_id & id) {
+    const std::string hi = id.layer_hi == ID_ANY_I32 ? "?" : std::to_string(id.layer_hi);
+    return "layers [" + std::to_string(id.layer_lo) + ", " + hi + ") of a " +
+           std::to_string(id.n_layer_src) + "-layer model (n_embd_inp " +
+           std::to_string(id.n_embd_inp) + ", n_embd_out " + std::to_string(id.n_embd_out) +
+           ", n_vocab " + std::to_string(id.n_vocab) + ", role " + role_name(id.role) + ")";
+}
+
+// Every field is compared; the list is built rather than short-circuited so one failure message
+// names all the numbers that disagree. An empty answer means the identity matches.
+std::string identity_mismatch(const stage_id & expect, const stage_id & got) {
+    std::string out;
+    const auto add = [&out](const char * field, const std::string & want, const std::string & have) {
+        if (!out.empty()) {
+            out += "; ";
+        }
+        out += std::string(field) + " expected " + want + ", the stage reports " + have;
+    };
+    if (expect.layer_lo != got.layer_lo) {
+        add("layer_lo", std::to_string(expect.layer_lo), std::to_string(got.layer_lo));
+    }
+    if (expect.layer_hi != ID_ANY_I32 && expect.layer_hi != got.layer_hi) {
+        add("layer_hi", std::to_string(expect.layer_hi), std::to_string(got.layer_hi));
+    }
+    if (expect.n_layer_src != got.n_layer_src) {
+        add("n_layer_src", std::to_string(expect.n_layer_src), std::to_string(got.n_layer_src));
+    }
+    if (expect.n_embd_inp != got.n_embd_inp) {
+        add("n_embd_inp", std::to_string(expect.n_embd_inp), std::to_string(got.n_embd_inp));
+    }
+    if (expect.n_embd_out != got.n_embd_out) {
+        add("n_embd_out", std::to_string(expect.n_embd_out), std::to_string(got.n_embd_out));
+    }
+    if (expect.n_vocab != got.n_vocab) {
+        add("n_vocab", std::to_string(expect.n_vocab), std::to_string(got.n_vocab));
+    }
+    if (expect.role != ROLE_ANY && expect.role != got.role) {
+        add("role", role_name(expect.role), role_name(got.role));
+    }
+    return out;
+}
+
+} // namespace
+
+llama_split_remote::~llama_split_remote() {
+    close();
+}
+
+bool llama_split_remote::state_size(int32_t seq_id, uint32_t flags, uint32_t & n_bytes, int32_t & pos_max, std::string & err) {
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_STATE_SAVE;
+    // [QLH-SPLIT] v6: the size the head has to make room for is the *handle record*, not the
+    // stage's state. Asking with the handle flag is what makes the stage answer with what
+    // state_take() would actually give back (STATE_HANDLE_BYTES), and it keeps the size query
+    // and the save in the same mode -- they are two round trips and the head checks that the
+    // second agrees with the first.
+    req.flags   = (uint8_t) ((flags & 0xFF) | STATE_FLAG_SIZE_ONLY | STATE_FLAG_HANDLE);
+    req.seq_id  = seq_id;
+
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+    if (!send_all(&req, sizeof(req))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    if (rsp.status != ST_OK) {
+        err = "stage refused the state size query";
+        return false;
+    }
+    if (rsp.n_bytes > MAX_STATE) {
+        err = "stage reported an implausible state size";
+        return false;
+    }
+    n_bytes = rsp.n_bytes;
+    pos_max = rsp.pos_max;
+    return true;
+}
+
+bool llama_split_remote::state_take(int32_t seq_id, uint32_t flags, uint64_t & handle, int32_t & pos_max, std::string & err) {
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_STATE_SAVE;
+    req.flags   = (uint8_t) ((flags & 0xFF) | STATE_FLAG_HANDLE);
+    req.seq_id  = seq_id;
+
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+    if (!send_all(&req, sizeof(req))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    if (rsp.status != ST_OK) {
+        err = "stage refused the state save";
+        return false;
+    }
+    if (rsp.n_bytes != STATE_HANDLE_BYTES) {
+        // A stage that answered with its whole blob here would be a pre-v6 one, but the version
+        // in the header already ruled that out -- so this is a corrupt frame, not a slow path.
+        err = "stage answered " + std::to_string(rsp.n_bytes) + " bytes for a snapshot handle, "
+              "expected " + std::to_string(STATE_HANDLE_BYTES);
+        return false;
+    }
+
+    uint64_t h = 0;
+    if (!recv_all(&h, sizeof(h))) {
+        err = "recv snapshot handle failed";
+        return false;
+    }
+    if (h == 0) {
+        err = "stage answered a zero snapshot handle";
+        return false;
+    }
+    handle  = h;
+    pos_max = rsp.pos_max;
+    return true;
+}
+
+bool llama_split_remote::state_give(int32_t seq_id, uint32_t flags, uint64_t handle, int32_t pos_expected,
+                                    int32_t & pos_max_before, bool & stale, std::string & err) {
+    stale = false;
+
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_STATE_LOAD;
+    req.flags   = (uint8_t) ((flags & 0xFF) | STATE_FLAG_HANDLE);
+    req.seq_id  = seq_id;
+    req.pos0    = pos_expected;
+    req.n_bytes = STATE_HANDLE_BYTES;
+
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+    if (!send_all(&req, sizeof(req)) || !send_all(&handle, sizeof(handle))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    pos_max_before = rsp.pos_max;
+
+    if (rsp.status == ST_STALE) {
+        // Not a failure: the stage dropped the snapshot (cache eviction, or a restart) and did
+        // not touch its memory. The caller must recover by re-processing, not by killing the
+        // chain -- see the contract in llama-split-remote.h and the server branch that uses it.
+        stale = true;
+        return true;
+    }
+    if (rsp.status != ST_OK) {
+        err = "stage refused the state load (its position is " + std::to_string(rsp.pos_max) +
+              ", the snapshot was taken at " + std::to_string(pos_expected) + ")";
+        return false;
+    }
+    return true;
+}
+
+bool llama_split_remote::state_load(int32_t seq_id, uint32_t flags, const std::vector<uint8_t> & blob,
+                                    int32_t pos_expected, int32_t & pos_max_before, std::string & err) {
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_STATE_LOAD;
+    req.flags   = (uint8_t) (flags & 0xFF);
+    req.seq_id  = seq_id;
+    req.pos0    = pos_expected;
+    req.n_bytes = (uint32_t) blob.size();
+
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+    if (blob.size() > MAX_STATE) {
+        err = "state blob too large to send";
+        return false;
+    }
+    if (!send_all(&req, sizeof(req)) || (!blob.empty() && !send_all(blob.data(), blob.size()))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    if (rsp.status != ST_OK) {
+        pos_max_before = rsp.pos_max;
+        err = "stage refused the state load (its position is " + std::to_string(rsp.pos_max) +
+              ", the snapshot was taken at " + std::to_string(pos_expected) + ")";
+        return false;
+    }
+    pos_max_before = rsp.pos_max;
+    return true;
+}
+
+void llama_split_remote::close() {
+    close(true);
+}
+
+void llama_split_remote::close(bool send_bye) {
+    if (net::valid(sock)) {
+        if (send_bye && greeted) {
+            // Best effort BYE so the stage returns to accept() instead of logging a broken pipe.
+            // Only after a completed HELLO: a v4 stage refuses any first frame that is not one,
+            // so a BYE on a half-open attach would be reported as a protocol error there.
+            req_header h{};
+            h.magic   = MAGIC;
+            h.version = PROTO_VER;
+            h.op      = OP_BYE;
+            send_all(&h, sizeof(h));
+        }
+        net::close_sock(sock);
+        sock = net::invalid;
+    }
+    greeted = false;
+}
+
+bool llama_split_remote::connect_endpoint(const std::string & endpoint, std::string & err, int connect_ms, int io_ms) {
+    ep = endpoint;
+
+    std::string host;
+    uint16_t    port = 0;
+    if (!parse_endpoint(endpoint, host, port)) {
+        err = "bad endpoint '" + endpoint + "', expected host:port";
+        return false;
+    }
+
+    // Winsock setup lives in llama-split-net.cpp: the stage and this client must not carry
+    // separate WSAStartup paths, or one of them ends up initializing after its first socket call.
+    if (!net::global_init()) {
+        err = "WSAStartup failed";
+        return false;
+    }
+
+    addrinfo hints{};
+    hints.ai_family   = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+
+    addrinfo * res = nullptr;
+    const std::string port_s = std::to_string(port);
+    if (getaddrinfo(host.c_str(), port_s.c_str(), &hints, &res) != 0 || res == nullptr) {
+        err = "cannot resolve " + host;
+        return false;
+    }
+
+    net::sock_t s = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+    if (!net::valid(s)) {
+        freeaddrinfo(res);
+        err = "socket() failed";
+        return false;
+    }
+
+    // A rebuild may have to run on a request thread while the stage is still down, so the connect
+    // itself has to be bounded too (a blocking connect to a host that is not answering waits out
+    // the kernel's SYN retries, ~21 s on Windows). The initial attach keeps the ordinary blocking
+    // connect: a chain that cannot reach its stage at startup should say so with the OS's own
+    // error, not with a deadline nobody can distinguish from a slow network.
+    if (!net::connect_timeout(s, res->ai_addr, (int) res->ai_addrlen, connect_ms)) {
+        freeaddrinfo(res);
+        net::close_sock(s);
+        err = connect_ms > 0
+            ? "cannot connect to " + endpoint + " within " + std::to_string(connect_ms) + " ms"
+            : "cannot connect to " + endpoint;
+        return false;
+    }
+    freeaddrinfo(res);
+
+    // [QLH-SPLIT] Nagle off for the life of the connection (see llama-split-net.h).
+    //
+    // This side had it from the start, which is exactly why the *up* direction never showed the
+    // 48-52 ms gap the proxy trace caught: every request frame (header + 8 KB hidden rows) left
+    // immediately, 0.1-0.2 ms apart. The stage side did not, so its 32 B header + 320 B
+    // candidate body paid the delayed-ACK wait instead. Setting it here through the shared
+    // helper keeps both ends from drifting apart again.
+    net::set_nodelay(s);
+
+    // [QLH-SPLIT] The stage protocol has no other timing bound, so a stage that stops answering
+    // mid-flight -- suspended, killed in a way that leaves the connection half-open, a NIC that
+    // went away -- blocks the driving slot forever. Nothing in llama-server notices by default:
+    // /health reports whether the model is loaded, not whether the chain is moving, so an
+    // orchestrator keeps routing traffic at a server that can no longer emit a token. A read
+    // timeout makes that an ordinary failed request (recv_all returns false -> decode returns
+    // -3, or seq_rm fails and marks the chain dead) which the server already reports.
+    //
+    // 120 s is chosen to be far above any honest stage latency: the slowest answer this chain
+    // asks for is one -ubatch of prefill on CPU, which is seconds at the batch sizes and models
+    // it is used with, not minutes. It only has to be finite; making it smaller starts cutting
+    // working requests on a busy machine, and making it configurable would turn a safety net
+    // into something an operator can misconfigure.
+    if (!net::set_timeout(s, io_ms)) {
+        net::close_sock(s);
+        err = "cannot set a read timeout on the connection to " + endpoint;
+        return false;
+    }
+
+    sock = s;
+    greeted = false; // a fresh socket has not been through a HELLO yet
+    return true;
+}
+
+bool llama_split_remote::connect(const std::string & endpoint, std::string & err) {
+    close();
+    // A new connection has not confirmed anything yet. reconnect() must keep `confirmed` (that is
+    // what it demands back), so this reset lives here and not in connect_endpoint().
+    confirmed      = stage_id{};
+    have_confirmed = false;
+    return connect_endpoint(endpoint, err, 0, kStageTimeoutMs);
+}
+
+bool llama_split_remote::hello(const stage_id & expect, stage_id * got, std::string & err) {
+    if (got != nullptr) {
+        *got = stage_id{};
+    }
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_HELLO;
+    req.n_bytes = (uint32_t) sizeof(stage_id);
+    if (!send_all(&req, sizeof(req)) || !send_all(&expect, sizeof(expect))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        // A stage that predates v4 checks the version on the first frame and answers BAD_REQ, so
+        // this really is "no answer", not "wrong answer": name the build skew as the likely cause
+        // instead of leaving the operator to blame the network.
+        err = "the stage did not answer the identity handshake (it may be a pre-v4 split-stage, "
+              "or not a split-stage at all); this build speaks the v" +
+              std::to_string((unsigned) PROTO_VER) + " protocol";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+
+    // From here on the peer is in the protocol state: a close may send BYE even if the identity
+    // check below fails.
+    greeted = true;
+
+    stage_id self{};
+    if (rsp.n_bytes != 0) {
+        if (rsp.n_bytes != sizeof(stage_id)) {
+            err = "bad HELLO reply: the stage sent " + std::to_string(rsp.n_bytes) +
+                  " bytes of identity, this build expects " + std::to_string(sizeof(stage_id)) +
+                  " (the two ends were not built from the same source tree)";
+            return false;
+        }
+        if (!recv_all(&self, sizeof(self))) {
+            err = "recv failed";
+            return false;
+        }
+    }
+    if (got != nullptr) {
+        *got = self;
+    }
+    if (rsp.status != ST_OK) {
+        err = "the stage refused the identity handshake: the stage is " + describe_identity(self) +
+              ", the chain expects " + describe_expect(expect);
+        return false;
+    }
+
+    const std::string diff = identity_mismatch(expect, self);
+    if (!diff.empty()) {
+        err = "stage identity mismatch: this stage is " + describe_identity(self) +
+              ", but the chain expects " + describe_expect(expect) + " (" + diff + "). " +
+              "It looks like the wrong stage is listening on " + ep + ".";
+        return false;
+    }
+
+    // Only an identity that matched is remembered: reconnect() must demand exactly this stage
+    // back, not "a stage that answered the same expectations" (which for a middle stage would
+    // leave its layer_hi unpinned).
+    confirmed      = self;
+    have_confirmed = true;
+    return true;
+}
+
+bool llama_split_remote::reconnect(std::string & err) {
+    // No BYE: see the header. The old socket is closed unconditionally -- even if the stage has
+    // already answered nothing for a while, this side is the only one that can drop it.
+    close(false);
+
+    if (ep.empty()) {
+        err = "this stage has no endpoint recorded; it was never connected";
+        return false;
+    }
+    if (!have_confirmed) {
+        // No successful attach ever happened on this client, so there is no identity to demand.
+        // Refusing is the safe answer: a rebuild exists to restore a chain that was built.
+        err = "this stage has no confirmed identity; it was never attached";
+        return false;
+    }
+    if (!connect_endpoint(ep, err, kRebuildTimeoutMs, kRebuildTimeoutMs)) {
+        return false;
+    }
+
+    // The whole point of the rebuild: a TCP connection is not "the stage is back". Give up the
+    // socket on a mismatch rather than leaving a half-verified connection in place, so the chain
+    // stays dead and the next attempt starts clean.
+    stage_id seen{};
+    std::string why;
+    if (!hello(confirmed, &seen, why)) {
+        close(false);
+        err = "reconnected, but the stage now listening there is not the one this chain was "
+              "built from: " + why;
+        return false;
+    }
+    return true;
+}
+
+bool llama_split_remote::restore_data_timeout() {
+    return net::valid(sock) && net::set_timeout(sock, kStageTimeoutMs);
+}
+
+bool llama_split_remote::send_all(const void * src, size_t n) {
+    return net::send_all(sock, src, n);
+}
+
+bool llama_split_remote::recv_all(void * dst, size_t n) {
+    return net::recv_all(sock, dst, n);
+}
+
+int llama_split_remote::decode(const std::vector<float> & hidden,
+                               const std::vector<int32_t> & positions,
+                               uint32_t n_pos,
+                               uint32_t n_embd,
+                               int32_t seq_id,
+                               const cand_req * cand,
+                               const std::vector<llama_logit_bias> & cand_bias,
+                               const std::vector<llama_token> & cand_hist,
+                               bool verify_rows,
+                               bool nextn_rows,
+                               const llama_split_tap_req & tap,
+                               std::vector<float> & out_hidden,
+                               std::vector<float> & out_logits,
+                               uint32_t & out_n_vocab,
+                               std::vector<token_cand> & out_cands,
+                               std::vector<int32_t> & out_verify,
+                               std::vector<float> & out_nextn,
+                               uint32_t & out_nextn_embd,
+                               llama_split_tap_out & out_tap,
+                               std::string & err) {
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return -3;
+    }
+    if (n_pos == 0 || positions.size() != (hidden.size() / (n_embd == 0 ? 1 : n_embd)) * n_pos) {
+        err = "positions/hidden size mismatch";
+        return -1;
+    }
+
+    const uint32_t n_tok = (uint32_t) (hidden.size() / (n_embd == 0 ? 1 : n_embd));
+
+    // [QLH-SPLIT] v9: ask for the layer-input taps of this frame. Empty/null ids means "send no tap
+    // request", which is what a whole-model and a local chain always have.
+    const size_t n_tap_ask = tap.ids != nullptr ? tap.ids->size() : 0;
+
+    req_header req{};
+    req.magic    = MAGIC;
+    req.version  = PROTO_VER;
+    req.op       = OP_DECODE;
+    req.flags    = (uint8_t) ((cand != nullptr ? DECODE_FLAG_CANDIDATES : 0) |
+                              (verify_rows       ? DECODE_FLAG_VERIFY_ROWS : 0) |
+                              (nextn_rows        ? DECODE_FLAG_NEXTN_ROWS : 0) |
+                              (n_tap_ask > 0     ? DECODE_FLAG_LAYER_INP   : 0));
+    req.n_tokens = n_tok;
+    req.n_embd   = n_embd;
+    req.n_pos    = n_pos;
+    req.seq_id   = seq_id;
+
+    if (!send_all(&req, sizeof(req)) ||
+        !send_all(positions.data(), positions.size() * sizeof(int32_t)) ||
+        !send_all(hidden.data(), hidden.size() * sizeof(float))) {
+        err = "send failed";
+        return -3;
+    }
+
+    if (cand != nullptr) {
+        // The candidate request is the tail's input for the steps *before* top_k. Its history
+        // and biases are sent per frame rather than kept on the stage: see cand_req.
+        cand_req c = *cand;
+        c.n_bias = (uint32_t) cand_bias.size();
+        c.n_hist = (uint32_t) cand_hist.size();
+        if (!send_all(&c, sizeof(c))) {
+            err = "send failed";
+            return -3;
+        }
+        if (!cand_bias.empty() &&
+            !send_all(cand_bias.data(), cand_bias.size() * sizeof(llama_logit_bias))) {
+            err = "send failed";
+            return -3;
+        }
+        if (!cand_hist.empty() &&
+            !send_all(cand_hist.data(), cand_hist.size() * sizeof(llama_token))) {
+            err = "send failed";
+            return -3;
+        }
+    }
+
+    if (n_tap_ask > 0) {
+        // [QLH-SPLIT] v9: the tap request goes last in the frame, so a stage reads the candidate
+        // block before it and both sections stay self-describing (see layer_inp_req).
+        static_assert(sizeof(uint32_t) == sizeof(int32_t), "layer ids travel as int32");
+        layer_inp_req treq{};
+        treq.n_taps = (uint32_t) n_tap_ask;
+        treq.n_embd = tap.n_embd;
+        std::vector<int32_t> ids(n_tap_ask);
+        for (size_t i = 0; i < n_tap_ask; ++i) {
+            ids[i] = (int32_t) (*tap.ids)[i];
+        }
+        if (!send_all(&treq, sizeof(treq)) ||
+            !send_all(ids.data(), ids.size() * sizeof(int32_t))) {
+            err = "send failed";
+            return -3;
+        }
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return -3;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return -3;
+    }
+
+    switch (rsp.status) {
+        case ST_OK: break;
+        case ST_NO_SPACE: return 1;
+        // [QLH-SPLIT] v8: the stage cannot answer this *frame's capability* (no h_nextn rows, no
+        // draft head). The frame was consumed and nothing moved, so this is the same class of
+        // answer as "no space": the caller falls back, the chain stays alive.
+        case ST_UNSUPPORTED: return 1;
+        case ST_BAD_REQ:  err = "stage rejected the request"; return -1;
+        default:          err = "stage reported an internal error"; return -3;
+    }
+
+    out_hidden.clear();
+    out_logits.clear();
+    out_cands.clear();
+    out_verify.clear();
+    out_nextn.clear();
+    out_tap.ids.clear();
+    out_tap.rows.clear();
+    out_tap.n_embd = 0;
+    out_n_vocab    = 0;
+    out_nextn_embd = 0;
+
+    // [QLH-SPLIT] v8: the body sections are read in the order the protocol documents --
+    // per-row ids, then h_nextn rows, then candidates or the logits row, and (v9) the layer-input
+    // taps after all of them. So a reply can carry several channels without either side guessing.
+    const size_t   nextn_off   = (rsp.flags & RSP_FLAG_VERIFY_ROWS) ? (size_t) rsp.n_tokens * sizeof(int32_t) : 0;
+    const uint32_t nextn_wide  = (rsp.flags & RSP_FLAG_NEXTN_ROWS) ? rsp.n_embd : 0;
+    const size_t   nextn_bytes = (size_t) rsp.n_tokens * nextn_wide * sizeof(float);
+
+    // [QLH-SPLIT] v9: the tap section this reply owes, and the check that it is exactly the shape this
+    // frame asked for. A tap row is *per frame row*, not per answered row: the draft injects every
+    // position of the batch, so n_rows is this request's own row count and never something the stage
+    // reports. n_taps, by contrast, is the stage's answer -- it owns some of the ids and skips the
+    // rest -- so it travels in the header.
+    //
+    // Two reply shapes carry taps. A tail answers one of the three output channels plus taps, and then
+    // rsp.n_embd names the tap width (that is the only width it is *not* already stating elsewhere). A
+    // relay answers hidden rows plus taps, and there rsp.n_embd is the hidden width -- the tap width is
+    // the one this frame asked for, which is why the request carries it and the reply does not repeat
+    // it.
+    const bool reply_is_hidden = rsp.n_vocab == 0 && rsp.n_embd > 0 &&
+                                 (rsp.flags & (RSP_FLAG_VERIFY_ROWS | RSP_FLAG_CANDIDATES |
+                                               RSP_FLAG_NEXTN_ROWS)) == 0;
+    const bool tap_on_hidden   = reply_is_hidden && (rsp.flags & RSP_FLAG_LAYER_INP) != 0;
+    const uint32_t tap_wide    = tap_on_hidden ? tap.n_embd : rsp.n_embd;
+
+    uint64_t tap_bytes = 0;
+    if (rsp.flags & RSP_FLAG_LAYER_INP) {
+        if (n_tap_ask == 0) {
+            err = "stage answered layer-input taps that were not requested";
+            return -3;
+        }
+        if (rsp.n_taps == 0 || rsp.n_taps > n_tap_ask || rsp.n_taps > MAX_LAYER_INP_TAPS) {
+            err = "stage answered " + std::to_string((unsigned) rsp.n_taps) + " layer-input taps for a " +
+                  std::to_string(n_tap_ask) + "-tap request";
+            return -3;
+        }
+        if (tap_wide == 0 || tap_wide != tap.n_embd) {
+            err = "stage answered layer-input taps that are " + std::to_string(tap_wide) +
+                  " wide, the frame asked for " + std::to_string(tap.n_embd);
+            return -3;
+        }
+        // A tap block wider than one frame's rows * taps * n_embd would overflow n_bytes, so the
+        // arithmetic is done in 64 bits and the frame is refused instead of truncated.
+        tap_bytes = (uint64_t) rsp.n_taps * sizeof(int32_t) +
+                    (uint64_t) n_tok * rsp.n_taps * tap_wide * sizeof(float);
+        if (tap_bytes > (uint64_t) rsp.n_bytes) {
+            err = "stage answered " + std::to_string(rsp.n_bytes) + " bytes for a tap section of " +
+                  std::to_string(tap_bytes) + " (" + std::to_string((unsigned) rsp.n_taps) +
+                  " taps x " + std::to_string(n_tok) + " rows x " + std::to_string(tap_wide) + ")";
+            return -3;
+        }
+    } else if (n_tap_ask > 0) {
+        // Not an error: a stage that owns none of the named layers ignores the request, exactly like
+        // a stage without a NextN block ignores DECODE_FLAG_NEXTN_ROWS. The caller decides what a
+        // missing tap means.
+    } else if (rsp.n_taps != 0) {
+        err = "stage named layer-input taps in a reply that carries none";
+        return -3;
+    }
+
+    // [QLH-SPLIT] v9: the tap section is last, so every early exit below has to consume it first.
+    // One lambda instead of four copies of the same read.
+    const auto read_tap = [&]() -> int {
+        if (!(rsp.flags & RSP_FLAG_LAYER_INP)) {
+            return 0;
+        }
+        out_tap.ids.resize(rsp.n_taps);
+        if (!recv_all(out_tap.ids.data(), out_tap.ids.size() * sizeof(uint32_t))) {
+            err = "recv layer-input tap ids failed";
+            return -3;
+        }
+        out_tap.rows.resize((size_t) n_tok * rsp.n_taps * tap_wide);
+        if (!out_tap.rows.empty() &&
+            !recv_all(out_tap.rows.data(), out_tap.rows.size() * sizeof(float))) {
+            err = "recv layer-input tap rows failed";
+            return -3;
+        }
+        out_tap.n_embd = tap_wide;
+        return 0;
+    };
+
+    if (reply_is_hidden && !tap_on_hidden) {
+        out_hidden.resize((size_t) rsp.n_tokens * rsp.n_embd);
+        if (!recv_all(out_hidden.data(), out_hidden.size() * sizeof(float))) {
+            err = "recv hidden failed";
+            return -3;
+        }
+        return 0;
+    }
+
+    // [QLH-SPLIT] v9: a relay that owns taps answers its hidden rows first and the tap block last.
+    if (tap_on_hidden) {
+        if (rsp.n_tokens != n_tok || rsp.n_embd != n_embd) {
+            err = "stage answered " + std::to_string(rsp.n_tokens) + " hidden rows of " +
+                  std::to_string(rsp.n_embd) + " for a " + std::to_string(n_tok) + "-row frame of " +
+                  std::to_string(n_embd);
+            return -3;
+        }
+        const uint64_t hidden_bytes = (uint64_t) n_tok * n_embd * sizeof(float);
+        if ((uint64_t) rsp.n_bytes != hidden_bytes + tap_bytes) {
+            err = "stage answered " + std::to_string(rsp.n_bytes) + " bytes for " +
+                  std::to_string(hidden_bytes) + " hidden bytes plus " + std::to_string(tap_bytes) +
+                  " of taps";
+            return -3;
+        }
+        out_hidden.resize((size_t) n_tok * n_embd);
+        if (!recv_all(out_hidden.data(), out_hidden.size() * sizeof(float))) {
+            err = "recv hidden failed";
+            return -3;
+        }
+        if (read_tap() != 0) {
+            return -3;
+        }
+        return 0;
+    }
+
+    if (rsp.flags & RSP_FLAG_VERIFY_ROWS) {
+        // The tail answered the per-row request: one int32 token id per row of the frame it was
+        // handed, in row order. The frame carried no extra bytes, so the count is the request's
+        // own n_tokens -- checking it catches a stage that answered a different frame number
+        // rather than letting the caller index an array that does not describe its batch.
+        if (!verify_rows) {
+            err = "stage answered per-row results that were not requested";
+            return -3;
+        }
+        if (rsp.n_tokens != n_tok || rsp.n_bytes < nextn_off + nextn_bytes + tap_bytes) {
+            err = "stage answered " + std::to_string(rsp.n_tokens) + " rows / " +
+                  std::to_string(rsp.n_bytes) + " bytes for a " + std::to_string(n_tok) +
+                  "-row verify frame, expected at least " +
+                  std::to_string(n_tok * sizeof(int32_t)) + " bytes";
+            return -3;
+        }
+        out_verify.resize(n_tok);
+        if (!recv_all(out_verify.data(), out_verify.size() * sizeof(int32_t))) {
+            err = "recv per-row tokens failed";
+            return -3;
+        }
+    }
+
+    // nextn and layer-input taps are mutually exclusive on the wire (one reply has one n_embd field),
+    // so a stage that set both is answering a frame no build of this tree sends.
+    if ((rsp.flags & RSP_FLAG_NEXTN_ROWS) && (rsp.flags & RSP_FLAG_LAYER_INP)) {
+        err = "stage answered both h_nextn rows and layer-input taps in one reply";
+        return -3;
+    }
+
+    if (rsp.flags & RSP_FLAG_NEXTN_ROWS) {
+        if (!nextn_rows) {
+            err = "stage answered h_nextn rows that were not requested";
+            return -3;
+        }
+        // The stage decides how many rows it owes (all rows of a verify frame, the last one
+        // otherwise) and says so through n_tokens, which is the frame's row count for a verify
+        // reply and 1 for a plain one. Both are checked against the width, so a stage that
+        // answered a different shape is caught here instead of shifting every later reply.
+        const uint32_t n_rows = rsp.n_tokens;
+        if (rsp.n_embd != n_embd || n_rows == 0 ||
+            nextn_bytes != (size_t) n_rows * n_embd * sizeof(float) ||
+            (!(rsp.flags & RSP_FLAG_VERIFY_ROWS) && n_rows != 1)) {
+            err = "stage answered implausible h_nextn rows (n_tokens " + std::to_string(rsp.n_tokens) +
+                  ", n_embd " + std::to_string(rsp.n_embd) + ", n_bytes " +
+                  std::to_string(rsp.n_bytes) + ")";
+            return -3;
+        }
+        out_nextn.resize((size_t) n_rows * rsp.n_embd);
+        if (!recv_all(out_nextn.data(), out_nextn.size() * sizeof(float))) {
+            err = "recv h_nextn rows failed";
+            return -3;
+        }
+        out_nextn_embd = rsp.n_embd;
+    }
+
+    if (rsp.flags & RSP_FLAG_VERIFY_ROWS) {
+        // Ids, the h rows (when asked) and the taps (when asked) were consumed above; nothing else
+        // follows a verify reply.
+        if (read_tap() != 0) {
+            return -3;
+        }
+        return 0;
+    }
+
+    if (rsp.flags & RSP_FLAG_CANDIDATES) {
+        // The tail answered the candidate request: n_bytes worth of (id, logit) pairs, already
+        // sorted by descending logit. A tail that refuses (a v4 build) fails the version check
+        // above; one that answers the row instead would leave this branch empty and out_logits
+        // filled, which decode_split() accepts as the slow-but-correct path -- the one thing it
+        // must not do is invent candidates.
+        if ((uint64_t) rsp.n_bytes < nextn_bytes + tap_bytes) {
+            err = "stage answered " + std::to_string(rsp.n_bytes) + " bytes for " +
+                  std::to_string(nextn_bytes) + " of h rows and " + std::to_string(tap_bytes) +
+                  " of taps";
+            return -3;
+        }
+        const uint32_t cand_bytes = rsp.n_bytes - (uint32_t) nextn_bytes - (uint32_t) tap_bytes;
+        if (cand_bytes % sizeof(token_cand) != 0 || cand_bytes == 0) {
+            err = "stage answered an implausible candidate payload (" +
+                  std::to_string(cand_bytes) + " bytes)";
+            return -3;
+        }
+        out_cands.resize(cand_bytes / sizeof(token_cand));
+        if (!recv_all(out_cands.data(), out_cands.size() * sizeof(token_cand))) {
+            err = "recv candidates failed";
+            return -3;
+        }
+        if (cand == nullptr) {
+            // The stage must not volunteer candidates: every later row would be sampled from a
+            // set nobody validated.
+            err = "stage answered candidates that were not requested";
+            return -3;
+        }
+        if (read_tap() != 0) {
+            return -3;
+        }
+        return 0;
+    }
+
+    const uint64_t logits_bytes = (uint64_t) rsp.n_vocab * sizeof(float);
+    // A logits reply has never carried n_bytes (the op predates the field being used for replies):
+    // the row is exactly n_vocab floats and the old parse read it without looking. So the tap
+    // arithmetic is only checked when the stage did set n_bytes -- a stage that sets it has to cover
+    // the row plus the taps, and one that leaves it 0 is answering the v8 shape, which is what the
+    // head parsed before this channel existed.
+    if (rsp.n_vocab > 0 && rsp.n_bytes > 0 &&
+        (uint64_t) rsp.n_bytes < logits_bytes + tap_bytes) {
+        err = "stage answered " + std::to_string(rsp.n_bytes) + " bytes for a " +
+              std::to_string(logits_bytes) + "-byte logits row and " +
+              std::to_string(tap_bytes) + " of taps";
+        return -3;
+    }
+    out_logits.resize(rsp.n_vocab);
+    if (rsp.n_vocab > 0 && !recv_all(out_logits.data(), out_logits.size() * sizeof(float))) {
+        err = "recv logits failed";
+        return -3;
+    }
+    out_n_vocab = rsp.n_vocab;
+    if (read_tap() != 0) {
+        return -3;
+    }
+    return 0;
+}
+
+// [QLH-SPLIT] v8: one MTP draft round over the wire. See llama-split-remote.h for the contract;
+// what is worth repeating here is the error split, because it is the same one the whole class
+// makes: a *transport* failure poisons the chain (-1, the caller marks it dead), while every
+// answer the stage gives that means "I cannot draft" is a 0 -- the request loses its drafts and
+// keeps generating. Returning -1 for ST_UNSUPPORTED would turn "the tail has no NextN block" into
+// "the chain is broken", which is exactly the failure mode this layer was built to avoid.
+int llama_split_remote::mtp_draft(const std::vector<float> & h, int32_t token, int32_t pos, uint32_t k,
+                                  int32_t seq_id, std::vector<int32_t> & out, std::string & err) {
+    out.clear();
+
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return -1;
+    }
+    if (!have_confirmed || confirmed.has_nextn == 0) {
+        // Not an error: this stage never said it could draft. The caller asked anyway (a stale
+        // plan), and the honest answer is "no drafts".
+        return 0;
+    }
+    if (k == 0 || k > MAX_MTP_DRAFT) {
+        err = "mtp draft k out of range";
+        return -1;
+    }
+    if (h.size() != confirmed.n_embd_out) {
+        err = "mtp draft hidden row is " + std::to_string(h.size()) + " wide, the stage is " +
+              std::to_string(confirmed.n_embd_out);
+        return -1;
+    }
+
+    req_header req{};
+    req.magic    = MAGIC;
+    req.version  = PROTO_VER;
+    req.op       = OP_MTP_DRAFT;
+    req.n_tokens = 1;
+    req.n_embd   = confirmed.n_embd_out;
+    req.n_pos    = 1;
+    req.seq_id   = seq_id;
+    req.n_bytes  = (uint32_t) sizeof(mtp_req);
+
+    mtp_req mreq{};
+    mreq.token = token;
+    mreq.pos   = pos;
+    mreq.k     = k;
+
+    if (!send_all(&req, sizeof(req)) ||
+        !send_all(&mreq, sizeof(mreq)) ||
+        !send_all(h.data(), h.size() * sizeof(float))) {
+        err = "send failed";
+        return -1;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return -1;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return -1;
+    }
+    switch (rsp.status) {
+        case ST_OK: break;
+        case ST_UNSUPPORTED:
+            // The capability is gone (the stage was restarted without its MTP context, or its
+            // draft context failed where the handshake said it was up). Not a chain failure: the
+            // stage consumed the frame and touched nothing.
+            err = "the stage cannot draft (no MTP context)";
+            return 0;
+        case ST_NO_SPACE:
+            err = "the stage has no room for the draft";
+            return 0;
+        case ST_BAD_REQ:
+            err = "stage rejected the draft request";
+            return -1;
+        default:
+            err = "stage reported an internal error while drafting";
+            return -1;
+    }
+
+    if (rsp.n_tokens == 0 || rsp.n_tokens > k ||
+        rsp.n_bytes != rsp.n_tokens * sizeof(int32_t)) {
+        err = "stage answered " + std::to_string(rsp.n_tokens) + " drafts / " +
+              std::to_string(rsp.n_bytes) + " bytes for a k=" + std::to_string(k) + " round";
+        return -1;
+    }
+    out.resize(rsp.n_tokens);
+    if (!recv_all(out.data(), out.size() * sizeof(int32_t))) {
+        err = "recv drafts failed";
+        return -1;
+    }
+    return (int) out.size();
+}
+
+bool llama_split_remote::seq_rm(int32_t seq_id, int32_t p0, int32_t p1, std::string & err) {
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_SEQ_RM;
+    req.seq_id  = seq_id;
+    req.pos0    = p0;
+    req.pos1    = p1;
+
+    if (!send_all(&req, sizeof(req))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    if (rsp.status != ST_OK) {
+        err = "stage refused seq_rm";
+        return false;
+    }
+    return true;
+}
+
+bool llama_split_remote::clear(std::string & err) {
+    if (!net::valid(sock)) {
+        err = "not connected";
+        return false;
+    }
+
+    req_header req{};
+    req.magic   = MAGIC;
+    req.version = PROTO_VER;
+    req.op      = OP_CLEAR;
+
+    if (!send_all(&req, sizeof(req))) {
+        err = "send failed";
+        return false;
+    }
+
+    rsp_header rsp{};
+    if (!recv_all(&rsp, sizeof(rsp))) {
+        err = "recv failed";
+        return false;
+    }
+    // Same header check as decode/seq_rm: without it a desynchronized stream (or a stage from
+    // another build) is read as if it were a valid answer.
+    if (!check_reply_header(rsp, err)) {
+        return false;
+    }
+    if (rsp.status != ST_OK) {
+        err = "stage refused clear";
+        return false;
+    }
+    return true;
+}
diff --git a/src/llama-split-remote.h b/src/llama-split-remote.h
new file mode 100644
index 000000000..310de098a
--- /dev/null
+++ b/src/llama-split-remote.h
@@ -0,0 +1,283 @@
+// [QLH-SPLIT] Client side of the stage protocol: a remote stage, seen from the driving process.
+//
+// This class exists so that decode_split does not have to know whether a stage is local or
+// over the network. It owns one connection to one split-stage process and offers exactly the
+// operations the chain needs: decode a batch of hidden rows, trim a sequence, clear.
+//
+// Error policy, and the reason it is not "retry until it works":
+//  - seq_rm has one failure exit. A transport failure and a stage that refuses the range are
+//    the same event for the chain: the KV of one stage is about to disagree with the others,
+//    and every later token's hidden state would be computed from a position the head no longer
+//    has. That is remembered as the chain's failure reason (llama_memory_split::remote_failure,
+//    set in llama-memory-split.cpp) and reported to common/common.cpp, which fails the request
+//    for a remote chain and still aborts for a local one -- a local stage cannot be blamed on
+//    the network, so there is nothing to recover. Reporting "the stage refused" differently
+//    from "we could not ask" would only move that decision to a caller that does not exist.
+//  - a decode transport failure maps to -3 ("compute failed"), which is what llama-server
+//    already understands as a hard error for that request. It does not retry: a stage that
+//    dropped mid-decode cannot be resumed without corrupting positions, and the chain has no
+//    n_past to resynchronize from.
+//  - clear has no error channel at all (llama_memory_i::clear returns void), so a failed clear
+//    is recorded as a dead-chain reason and poisons the next decode instead of being dropped.
+//  - the state ops are part of the checkpoint path, where a failure is not a failed request but
+//    a chain that must not keep serving: they report the failure to the caller, which turns it
+//    into a failed state restore (common/common.cpp and tools/server treat that as fatal for a
+//    checkpoint).
+#pragma once
+
+#include "llama.h"
+#include "llama-split-net.h"
+#include "llama-split-proto.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// [QLH-SPLIT] Why this class carries the "ask for candidates" flag instead of the sampler doing
+// the trip itself: the sampler lives in common/ and has no idea a stage exists; this is the only
+// layer that knows a decode is going over a socket. Keeping the wire choice here is also what
+// lets the fallback rule stay on the driving side, where the sampler chain is.
+
+// [QLH-SPLIT] v9: what one frame asks of the layer-input tap channel.
+//
+// `ids` are *source-model* layer ids, and every stage of a chain is sent the same list: each one
+// answers the ids inside its own [layer_lo, layer_hi) and drops the rest (see
+// DECODE_FLAG_LAYER_INP). That is why this side never has to know where the chain was cut beyond
+// what it already knows -- the head's own range -- and why a relay that owns taps answers them like
+// any tail would.
+struct llama_split_tap_req {
+    const std::vector<uint32_t> * ids    = nullptr; // nullptr or empty: do not ask
+    uint32_t                      n_embd = 0;       // trunk width of one tap row
+};
+
+// The taps a stage answered for one frame. `ids` holds the source-layer ids it owned, in reply
+// order, and `rows` is n_rows * ids.size() * n_embd floats: the first tap's row for batch row 0,
+// the second tap's row for row 0, ..., then row 1. Empty means "this stage had nothing to answer",
+// which is not an error -- a stage that owns none of the named layers ignores the request.
+struct llama_split_tap_out {
+    std::vector<uint32_t> ids;
+    std::vector<float>    rows;
+    uint32_t              n_embd = 0;
+};
+
+struct llama_split_remote {
+    llama_split_remote() = default;
+    ~llama_split_remote();
+
+    llama_split_remote(const llama_split_remote &) = delete;
+    llama_split_remote & operator=(const llama_split_remote &) = delete;
+
+    // Connects to host:port. Returns false on failure; `err` gets a human-readable reason.
+    //
+    // This only opens the socket. Every connection then starts with one OP_HELLO (hello() below),
+    // because a TCP connection says nothing about which stage answered: a stage restarted with a
+    // different --layer-range, a different model or a different depth would otherwise be driven
+    // as if it were the one the chain was built from, and every later token would be wrong with
+    // no error anywhere. Attach calls connect() then hello(); reconnect() repeats both.
+    //
+    // PROTO_VER is still checked on every reply header as well. A stage from another build is
+    // caught there, and now also at the first frame (its HELLO is refused, or it refuses ours),
+    // which is what makes a version skew a legible protocol error instead of a misread reply.
+    bool connect(const std::string & endpoint, std::string & err);
+
+    // [QLH-SPLIT] v4 identity handshake: sends `expect` and compares the stage's answer with it.
+    //
+    // `expect` is what the caller knows this position in the chain must be. Fields the caller
+    // cannot pin yet are ID_ANY_I32 (see llama-split-proto.h); role is pinned by position (every
+    // stage but the last is a relay). `got` (optional) receives the stage's own identity even
+    // when the comparison fails, so a caller can show both sides in one message.
+    //
+    // On success this records the answer as `confirmed`, which is what reconnect() later demands
+    // bit for bit: a stage that answers differently after a restart is not the stage this chain
+    // was built from, even if the new answer would be a valid stage somewhere else in a chain.
+    //
+    // On failure `err` is written to be printed as-is: it names the mismatching numbers and ends
+    // with what an operator should check (the wrong stage listening on the endpoint).
+    bool hello(const qlh_split::stage_id & expect, qlh_split::stage_id * got, std::string & err);
+
+    // [QLH-SPLIT] Re-establishes the connection to the endpoint this client was attached to,
+    // after the chain was marked dead, and proves it got the same stage back.
+    //
+    // Two differences from connect(), both load-bearing:
+    //  - it does NOT send BYE first. BYE is best-effort politeness for a peer that is going
+    //    away; after a failure the peer is by definition not answering, so a BYE is a write into
+    //    a socket nobody is draining -- buffered at best, blocked for the whole write timeout at
+    //    worst, before the reconnect even starts.
+    //  - every wait is bounded by a rebuild budget instead of the data-path timeout. A stage
+    //    that accepts the connection but never answers (suspended: the kernel still completes
+    //    the handshake out of the listen backlog) has to fail the attempt in seconds, not in
+    //    120 s, or the first request after a failure pays for the whole outage.
+    //
+    // The identity check runs inside that budget: after the TCP connect, the connection is
+    // greeted again and the answer must equal the identity confirmed at attach time. A stage
+    // restarted with a different --layer-range / model / depth answers the handshake and is
+    // then refused -- the chain stays dead and this returns false with the reason. Treating
+    // "connected again" as "the chain is back" is the silent-wrong-token bug this check exists
+    // to make impossible, so no caller may skip it.
+    //
+    // On success the socket carries the short timeout, and restore_data_timeout() puts it back on
+    // the data path. Both exist separately because the rebuild's clear() runs in between and is
+    // exactly the operation that has to be bounded.
+    bool reconnect(std::string & err);
+
+    // Back to the data-path read timeout. Returns false when it could not be set, which the
+    // caller treats as a failed rebuild: a connection with no failure bound is not usable.
+    bool restore_data_timeout();
+
+    bool connected() const { return qlh_split::net::valid(sock); }
+
+    // [QLH-SPLIT] v8: can this stage draft with its own MTP head? True when its OP_HELLO reported
+    // has_nextn, i.e. it owns a NextN block and built a draft context over it.
+    //
+    // Read from the identity confirmed at attach time, not from a live probe: whether a stage can
+    // draft is a property of the process that answered the handshake, and a stage restarted without
+    // the head answers ST_UNSUPPORTED later, which is handled as "no drafts" by mtp_draft(). This
+    // accessor only has to answer "is asking worth trying", never "will it work".
+    bool mtp_ready() const { return have_confirmed && confirmed.has_nextn != 0; }
+
+    // The endpoint this client was asked to connect to. Kept for error messages: when a stage
+    // fails, the operator has to know which one, and the endpoint is the only name a stage has
+    // on this side of the wire.
+    const std::string & endpoint() const { return ep; }
+
+    // Runs one decode. Input is n_tokens rows of n_embd floats; `positions` holds n_tokens *
+    // n_pos entries, section-major (the M-RoPE sections of every token, exactly as the head's
+    // graph used them -- see the note on llama_batch_allocr in llama-split-proto.h).
+    // On success either `out_hidden` (n_tokens * n_embd), `out_logits` (n_vocab) or
+    // `out_cands` (the top-k candidates) is filled, depending on this stage's role and on
+    // `cand` -- the caller asks, the stage's role disposes.
+    // Returns 0 on success, 1 when the stage is out of KV room, negative on error.
+    //
+    // [QLH-SPLIT] v5 candidate channel. `cand` (nullptr = send no candidate request) asks the
+    // tail to run the steps listed in it and answer with cand_req::top_k (id, logit) pairs
+    // instead of the whole row. `cand_bias` and `cand_hist` carry the logit biases and the recent
+    // token window those steps need; both are only read when `cand` is set.
+    //
+    // This is a wire-level choice and nothing more: the caller is responsible for having checked
+    // that the k candidates are a faithful substitute for the row (grammar, pre-sampling
+    // logprobs, top_k <= 0 -- see the fallback rule in common/sampling.h). Nothing here inspects
+    // the sampler, because this layer must stay usable by a caller that has no common/ at all.
+    //
+    // [QLH-SPLIT] v7 per-row verify channel. `verify_rows` asks the tail for one token id per
+    // batch row instead of one row of logits for the last one, and `out_verify` receives those
+    // ids in row order (n_tokens entries, 4 B each). The two channels answer different questions
+    // and are mutually exclusive; `cand != nullptr && verify_rows` is refused by the stage.
+    //
+    // Like the candidate channel this is only a wire choice: the caller must have established
+    // that every row it will read is a greedy argmax (common_sampler_verify_rows_check), because
+    // a token id cannot be re-sampled from -- there is no distribution in it.
+    // [QLH-SPLIT] v8 nextn channel. `nextn_rows` asks the tail to append the h_nextn rows of the
+    // rows it answers for (all rows of a verify frame, the last one otherwise) to whichever reply
+    // it gives; `out_nextn` receives them, row-major, and `out_nextn_embd` their width (0 when the
+    // stage did not answer them). A tail with no NextN block simply ignores the flag, so this call
+    // reports "no rows" rather than an error: the frame itself was fine, the capability is missing,
+    // and the caller drops one request's drafts.
+    //
+    // [QLH-SPLIT] v9 layer-input tap channel. `tap.ids` asks for the input rows of those source-model
+    // layers; every stage the frame is sent to answers the ones inside its own range and `out_tap`
+    // receives them ([n_tokens][n_answered][n_embd] plus the answered ids). A stage that owns none
+    // ignores the request, so `out_tap` comes back empty and that is not an error either -- the caller
+    // is the one that knows whether a missing tap matters, and it answers "draft without the
+    // injection" instead of failing the request.
+    int decode(const std::vector<float> & hidden,
+               const std::vector<int32_t> & positions,
+               uint32_t n_pos,
+               uint32_t n_embd,
+               int32_t seq_id,
+               const qlh_split::cand_req * cand,
+               const std::vector<llama_logit_bias> & cand_bias,
+               const std::vector<llama_token> & cand_hist,
+               bool verify_rows,
+               bool nextn_rows,
+               const llama_split_tap_req & tap,
+               std::vector<float> & out_hidden,
+               std::vector<float> & out_logits,
+               uint32_t & out_n_vocab,
+               std::vector<qlh_split::token_cand> & out_cands,
+               std::vector<int32_t> & out_verify,
+               std::vector<float> & out_nextn,
+               uint32_t & out_nextn_embd,
+               llama_split_tap_out & out_tap,
+               std::string & err);
+
+    // [QLH-SPLIT] v8: run this stage's MTP head for one draft round.
+    //
+    // `h` is one hidden row (n_embd floats): t_h_nextn of position pos-1, as the tail itself sent
+    // it back on the decode that produced `token`. `token` sits at `pos`; the k drafts are for
+    // pos+1 .. pos+k. Returns the number of drafts written to `out` (0 for "this stage cannot
+    // draft"), or -1 on a transport error, which poisons the chain exactly like a failed decode.
+    //
+    // The k steps are recursive inside the stage, so this is one round trip by construction. The
+    // drafts are greedy: the tail answers the argmax of each step, which is what the local chain's
+    // draft sampler produces (top_k = 10, then cur_p->data[0]) and what the greedy verify channel
+    // can accept.
+    int mtp_draft(const std::vector<float> & h, int32_t token, int32_t pos, uint32_t k,
+                  int32_t seq_id, std::vector<int32_t> & out, std::string & err);
+
+    // Drops [p0, p1) of a sequence. Returns true only when the stage actually did it.
+    bool seq_rm(int32_t seq_id, int32_t p0, int32_t p1, std::string & err);
+
+    bool clear(std::string & err);
+
+    // ---- sequence state (llama_state_seq_*) ----
+    //
+    // The stage holds the same kind of memory the head does, so the only thing a checkpoint
+    // cannot get from the wire is the size of its blob -- and that is what state_size() is for.
+    // All three report the stage's seq_pos_max alongside, because a chain's stages are
+    // position-synchronized by construction and a mismatch is the only cheap way to notice that
+    // one of them is no longer the one the checkpoint was taken from.
+
+    // Size of the stage's state in bytes, without transferring it.
+    bool state_size(int32_t seq_id, uint32_t flags, uint32_t & n_bytes, int32_t & pos_max, std::string & err);
+
+    // [QLH-SPLIT] v6: asks the stage to keep a snapshot of its sequence state and to answer with
+    // a handle for it. 8 bytes cross the wire in each direction instead of the blob.
+    bool state_take(int32_t seq_id, uint32_t flags, uint64_t & handle, int32_t & pos_max, std::string & err);
+
+    // Restores the snapshot `handle` names. Returns false only for a real failure. `stale` is set
+    // (with a true return) when the stage no longer holds that snapshot: nothing was applied and
+    // the chain is untouched, so the caller must treat it as "no checkpoint", never as a dead
+    // chain. `pos_max_before` reports the stage's position as it was before the attempt.
+    bool state_give(int32_t seq_id, uint32_t flags, uint64_t handle, int32_t pos_expected,
+                    int32_t & pos_max_before, bool & stale, std::string & err);
+
+    // The pre-v6 inline path, kept only for the state blob a slot file written by an older build
+    // still carries ({... 12.56 MiB of state ...} instead of a handle). Nothing in a v6 process
+    // produces it; reading it back is what keeps an old --slot-save-path file from being parsed
+    // as a handle.
+    bool state_load(int32_t seq_id, uint32_t flags, const std::vector<uint8_t> & blob,
+                    int32_t pos_expected, int32_t & pos_max_before, std::string & err);
+
+    void close();
+
+    // [QLH-SPLIT] Same, with the BYE optional. A rebuild closes a connection whose peer already
+    // stopped answering, so it must not spend a write timeout saying goodbye to it.
+    void close(bool send_bye);
+
+private:
+    qlh_split::net::sock_t sock = qlh_split::net::invalid;
+
+    // Set by connect(), kept after a failed re-connect so an error message can still name the
+    // stage the operator asked for.
+    std::string ep;
+
+    // [QLH-SPLIT] The identity this stage answered during a successful hello(). reconnect()
+    // demands this exact identity back: the chain is built around one specific stage per
+    // endpoint, and a restart that changes any of these numbers is a different stage, even if
+    // it would be valid somewhere else.
+    qlh_split::stage_id confirmed{};
+    bool                have_confirmed = false;
+
+    // Whether the peer has completed a HELLO on the current socket. Only a greeted connection
+    // gets the polite BYE on close: a connection that never finished the handshake is not in a
+    // state where the stage is waiting for it, and sending one anyway just produces a protocol
+    // error in the stage's log during a failed attach.
+    bool greeted = false;
+
+    // The one connect path: `connect_ms` 0 means an ordinary blocking connect, `io_ms` is the
+    // send/recv bound installed on the resulting socket.
+    bool connect_endpoint(const std::string & endpoint, std::string & err, int connect_ms, int io_ms);
+
+    bool send_all(const void * src, size_t n);
+    bool recv_all(void * dst, size_t n);
+};
diff --git a/src/llama.cpp b/src/llama.cpp
index e3699ea1d..e59530626 100644
