+
+namespace slim_arc {
+
+struct page_range {
+    uintptr_t address{0};
+    size_t length{0};
+    size_t skipped_bytes{0};
+    bool valid{false};
+    // Bytes covered outside the requested interval. Only used by
+    // covering_page_range; interior ranges leave this at zero.
+    size_t extra_bytes{0};
+};
+
