index 000000000..cc76cffbb
--- /dev/null
+++ b/src/llama-split-net.cpp
@@ -0,0 +1,252 @@
+// [QLH-SPLIT] See llama-split-net.h.
+#include "llama-split-net.h"
+
+#ifndef _WIN32
+// timeval for SO_RCVTIMEO/SO_SNDTIMEO: <sys/socket.h> is not required to pull it in.
+#  include <sys/time.h>
+// iovec/writev for send_two (scatter/gather).
+#  include <sys/uio.h>
+// fcntl / errno for the bounded connect below.
+#  include <fcntl.h>
+#  include <cerrno>
+#endif
+
+namespace qlh_split::net {
+
+bool global_init() {
+#ifdef _WIN32
+    static bool ready = false;
+    if (!ready) {
+        WSADATA wsa;
+        if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+            return false;
+        }
+        ready = true;
+    }
+#endif
+    return true;
+}
+
+void close_sock(sock_t s) {
+    if (!valid(s)) {
+        return;
+    }
+#ifdef _WIN32
+    closesocket(s);
+#else
+    ::close(s);
+#endif
+}
+
+bool send_all(sock_t s, const void * src, size_t n) {
+    const auto * p = (const uint8_t *) src;
+    while (n > 0) {
+        const int put = (int) send(s, (const char *) p, (int) n, 0);
+        if (put <= 0) {
+#ifdef _WIN32
+            return false;
+#else
+            // A signal (SIGCHLD, SIGALRM, a debugger stop) interrupts the call without the peer
+            // having gone anywhere: resume from the same offset instead of failing the request
+            // and, through the caller, marking a healthy chain dead. send_two() below already
+            // documents this case for the scatter/gather path; the two must not disagree about
+            // what a short/aborted write means.
+            if (put < 0 && errno == EINTR) {
+                continue;
+            }
+            return false;
+#endif
+        }
+        p += put;
+        n -= (size_t) put;
+    }
+    return true;
+}
+
+bool send_two(sock_t s, const void * a, size_t na, const void * b, size_t nb) {
+    // Scatter/gather, not memcpy: see the header. The loop only matters when the kernel accepts
+    // part of the request (a full send buffer, or a signal on POSIX); a partial transfer has to
+    // be resumed from the first buffer that still has bytes left, so the split is tracked here
+    // instead of in the caller.
+    const auto * pa = (const uint8_t *) a;
+    const auto * pb = (const uint8_t *) b;
+    while (na > 0 || nb > 0) {
+#ifdef _WIN32
+        WSABUF bufs[2];
+        DWORD nbufs = 0;
+        if (na > 0) {
+            bufs[nbufs].buf = (char *) pa;
+            bufs[nbufs].len = (ULONG) na;
+            ++nbufs;
+        }
+        if (nb > 0) {
+            bufs[nbufs].buf = (char *) pb;
+            bufs[nbufs].len = (ULONG) nb;
+            ++nbufs;
+        }
+        DWORD sent = 0;
+        if (WSASend(s, bufs, nbufs, &sent, 0, nullptr, nullptr) == SOCKET_ERROR || sent == 0) {
+            return false;
+        }
+        size_t left = (size_t) sent;
+#else
+        iovec iov[2];
+        int nbufs = 0;
+        if (na > 0) {
+            iov[nbufs].iov_base = (void *) pa;
+            iov[nbufs].iov_len  = na;
+            ++nbufs;
+        }
+        if (nb > 0) {
+            iov[nbufs].iov_base = (void *) pb;
+            iov[nbufs].iov_len  = nb;
+            ++nbufs;
+        }
+        const ssize_t sent = writev(s, iov, nbufs);
+        if (sent <= 0) {
+            // Same split as send_all(): an interrupted write is not a dead peer, and the loop
+            // below already tracks how much of each buffer is left, so resuming is just another
+            // iteration. A zero-length writev is not something POSIX produces.
+            if (sent < 0 && errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        size_t left = (size_t) sent;
+#endif
+        if (left < na) {
+            pa += left;
+            na -= left;
+        } else {
+            left -= na;
+            na = 0;
+            pb += left;
+            nb -= left;
+        }
+    }
+    return true;
+}
+
+bool set_nodelay(sock_t s) {
+    if (!valid(s)) {
+        return false;
+    }
+    int one = 1;
+#ifdef _WIN32
+    return setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char *) &one, sizeof(one)) == 0;
+#else
+    return setsockopt(s, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one)) == 0;
+#endif
+}
+
+bool recv_all(sock_t s, void * dst, size_t n) {
+    auto * p = (uint8_t *) dst;
+    while (n > 0) {
+        const int got = (int) recv(s, (char *) p, (int) n, 0);
+        if (got <= 0) {
+#ifdef _WIN32
+            return false;
+#else
+            // Same split as send_all(): an interrupted call is not a closed connection, but a
+            // zero-length read (got == 0) is the peer's EOF and must still fail.
+            if (got < 0 && errno == EINTR) {
+                continue;
+            }
+            return false;
+#endif
+        }
+        p += got;
+        n -= (size_t) got;
+    }
+    return true;
+}
