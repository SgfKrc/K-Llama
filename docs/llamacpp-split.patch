+void llm_graph_context::build_rs_shift_snapshots(
+        ggml_tensor * s,
+            int32_t   state_size,
+           uint32_t   n_rs,
+           uint32_t   rs_head,
+           uint32_t   rs_size,
+ const std::vector<uint32_t> & shifts) const {
+    const int64_t K     = (int64_t) cparams.n_rs_seq + 1;
+    const int64_t n_tok = ubatch.n_seq_tokens;
+
+    // a ubatch that fills every snapshot slot needs no shift: slots 0..K-1 are rewritten
