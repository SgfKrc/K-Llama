+    uintptr_t address,
+    size_t length,
+    size_t page_size) noexcept;
+
+page_range covering_page_range(
+    uintptr_t address,
+    size_t length,
+    size_t page_size) noexcept;
+
+page_range_set coalesce_page_ranges(std::vector<page_range> ranges) noexcept;
+
