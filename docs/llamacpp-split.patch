+                   (int) ok_whole, (int) ok_local, (int) ok_chain);
+        }
+    }
+
+    printf("\n=== %s ===\n", base_argmax == split_argmax ? "ARGMAX 一致" : "ARGMAX 不一致");
+    return base_argmax == split_argmax ? 0 : 2;
+}
