+
+// [QLH-SPLIT] Does this architecture have a pre-output-norm exit for the relay channel?
+//
+// A chain's head and every relay stage are asked for cparams.embeddings_pre_norm hidden, which
+// the graph builds by assigning t_embd = cur *before* output_norm. Only qwen35 and qwen35moe
+// implement that: their graph reads the flag and moves the assignment (src/models/qwen35.cpp,
+// src/models/qwen35moe.cpp). Every other architecture ignores cparams.embeddings_pre_norm and
+// fills t_embd from the post-norm tensor, so the next stage normalizes a second time. Nothing
+// downstream can see that: the argmax usually still matches and only the values are shifted, so
+// the chain serves plausible-but-wrong tokens with no error. The list is exactly the two arch
+// constants of those files -- adding an architecture here means implementing the exit there
+// first, not relaxing this check.
+static bool split_arch_exports_pre_norm(llm_arch arch) {
+    return arch == LLM_ARCH_QWEN35 || arch == LLM_ARCH_QWEN35MOE;
+}
+
+// [QLH-SPLIT] The head half of the chain check: every property of the head that both attach paths
+// have to refuse on, in one place, plus the identity every stage is then checked against.
+//
+// It used to be two hand-copied blocks, and they had drifted: the local one never compared
+// n_vocab, so a stage loaded from a different vocabulary was accepted and answered token ids that
+// meant something else, while the remote one did compare it on the wire (identity_mismatch in
+// llama-split-remote.cpp). Both callers now go through this, and both check every stage against
+// the head_expect it returns.
+//
+// What a head can be checked for, and why each check is here rather than at the stage:
+//  - it must export pre-norm hidden (split_arch_exports_pre_norm) and must be *asked* for it:
+//    embeddings + embeddings_pre_norm are context-construction flags, read once, so a head built
+//    without them hands over an empty carrier and the first decode fails with -3 seconds after
+//    startup said the chain was attached. This is about the head itself and cannot be delegated to
+//    the wire: the identity handshake reports what a stage loaded, not which tensor its graph
+//    writes at the end.
+//  - it must be a proper prefix of the source model: start at layer 0, end before the last layer.
+//    A head loaded with --split-layer-range 8:20 plus a tail 20:24 tiles 8..24 -- contiguous, ends
+//    at the last layer, passes every other check -- and then decodes a model whose first 8 layers
+//    were never computed (it never even loaded the token embedding, because needs_tok_embd() is
+//    false for a range that does not start at 0). Measured: it started, answered 200 and produced
+//    garbage. A head that already covers the whole model is the same failure from the other end:
+//    it decodes every layer and hands pre-norm hidden to stages expecting a later layer's input.
+//  - one hop width: n_embd_out == n_embd_inp. The carrier and the wire both carry one number, and
+//    a model where they differ would memcpy the wrong float count and then be refused by the
+//    consumer -- or, worse, silently read past the row.
+//
+// n_ctx / n_seq_max / n_rs_seq are deliberately not here: stage_id (src/llama-split-proto.h) has
+// no such fields, so they cannot be compared across the wire without a protocol change.
+//
+// `expect` is an out-parameter: on both attach paths it can only be derived from the head, so
+// filling it and checking the head against it happen here together and the caller never builds an
+// identity it would only be echoing (see the declaration in llama-context.h for the full reason).
+std::string llama_context::split_check_head(const llama_context & head, head_expect & expect) {
+    const auto & hp = head.model.hparams;
+
+    if (!split_arch_exports_pre_norm(head.model.arch)) {
+        return std::string("this architecture (") + llm_arch_name(head.model.arch) +
+               ") has no pre-output-norm exit; a chain head must hand the next stage the raw "
+               "hidden state, and only qwen35 / qwen35moe build that output";
+    }
+
+    if (!head.cparams.embeddings || !head.cparams.embeddings_pre_norm) {
+        return "this head was created without embeddings + embeddings_pre_norm; a chain head must "
+               "export its pre-norm hidden (llama_context_params::embeddings and "
+               "embeddings_pre_norm are context-construction flags and cannot be set later)";
+    }
+
+    if (hp.layer_hi < 0 || hp.n_layer_src <= 0) {
+        return "this context loaded the whole model; a chain head must load the first layer range "
+               "of the source model (--split-layer-range 0:N)";
+    }
+
+    if (hp.layer_lo != 0) {
+        return "a chain head must start at layer 0, but this context covers [" +
+               std::to_string(hp.layer_lo) + ", " + std::to_string(hp.layer_hi) + ") of " +
+               std::to_string(hp.n_layer_src) + "; load it from the first layer "
+               "(--split-layer-range 0:" + std::to_string(hp.layer_hi) + ") and continue with the "
+               "stages that follow it";
+    }
+
+    if (hp.layer_hi >= hp.n_layer_src) {
+        return "the head covers layers [0, " + std::to_string(hp.layer_hi) + ") of " +
+               std::to_string(hp.n_layer_src) + "; there is nothing left for the stages to do";
+    }
+
+    if (hp.n_embd_out() != hp.n_embd_inp()) {
+        return "this head exports " + std::to_string(hp.n_embd_out()) + "-wide hidden but "
+               "consumes " + std::to_string(hp.n_embd_inp()) + "-wide input; a chain hop carries "
+               "one width";
+    }
+
+    expect.n_layer_src = hp.n_layer_src;
+    expect.n_vocab     = head.model.vocab.n_tokens();
+    expect.n_embd      = hp.n_embd_out();
+    // [QLH-SPLIT] v10: the four chain-identity numbers. They come from the head's own context
+    // parameters, i.e. from the flags the operator typed here, and the stage reports what it was
+    // built with -- the handshake compares the two. n_ctx_seq rather than n_ctx: two ends may hold
+    // different raw -c and still give each sequence the same capacity, and that is the number that
+    // decides whether the chain works.
+    expect.n_seq_max     = head.cparams.n_seq_max;
+    expect.n_ctx_seq     = head.cparams.n_ctx_seq;
+    expect.n_rs_seq      = head.cparams.n_rs_seq;
+    expect.n_verify_rows = head.cparams.split_verify_rows;
+    return {};
+}
+
+// [QLH-SPLIT] Attach remote stages by endpoint. Returns the number attached, or -1 when the
+// chain already has local stages (see the note on split_remotes) or cannot be carried by the
+// stage protocol at all.
+int llama_context::split_attach_remote(const std::vector<std::string> & endpoints, std::string & err) {
+    if (!split_stages.empty()) {
+        err = "cannot mix local and remote stages in one chain";
+        return -1;
+    }
+
+    // [QLH-SPLIT] v10: a remote chain supports multiple sequences.
+    //
+    // The protocol used to carry one seq_id per OP_DECODE frame, so this function refused a context
+    // built with n_seq_max > 1 -- several sequences would have been folded into one. v10 makes the
+    // frame per-row (see row_req in src/llama-split-proto.h), so a batch that mixes sequences travels
+    // as what it is: each row carries its own sequence, its own position and its own output flag.
+    //
+    // What that leaves to agree on is the identity the handshake checks: -np / --n-seq-max, -c (which
+    // is what makes n_ctx_seq equal), --split-rs-seq / --rs-seq and --split-verify-rows. A mismatch in
+    // any of those is a hard failure mid-request, so they are compared at attach time -- see
+    // stage_id and identity_mismatch().
+    //
+    // M-RoPE is still checked where it can actually be seen: decode_split rejects a batch whose
+    // positions need more than the n_pos sections the protocol carries.
+
+    // Same capability check as the local path: the head of a remote chain is the stage that
+    // exports the pre-norm hidden the wire carries, so a head without that exit hands every
+    // remote stage a post-norm vector. This one is about the head itself and cannot be delegated
+    // to the v4 identity handshake: that reports what a stage loaded (range, width, depth), not
+    // which tensor its graph writes at the end. Refusing here is what turns "wrong chain, no
+    // error" into a startup failure for the whole class of models the fork cannot relay.
+    // [QLH-SPLIT] The head half of the check, shared with split_attach(): pre-norm exit, the
+    // context flags that select it, a proper prefix of the source model, one hop width. What the
+    // stages are checked against comes out of it as `expect` -- the head's own n_layer_src, its
+    // vocabulary and the single hop width. See split_check_head() for why each check is here and
+    // not on the wire.
+    head_expect expect;
+    err = split_check_head(*this, expect);
+    if (!err.empty()) {
+        return -1;
+    }
+
+    // The old view (if any) refers to the stages about to be destroyed. Drop it first: a failed
+    // connect below leaves no view, which is the state a failed attach is supposed to leave.
+    split_memory.reset();
+    split_remotes.clear();
+
+    // [QLH-SPLIT] v4: every connection starts with an identity handshake, and the chain checks it
+    // against what its own head says the position must be.
+    //
+    // What can be pinned here, and why it is enough to catch a wrong stage:
+    //  - the head's model fixes n_layer_src, both widths and n_vocab for every stage in the
+    //    chain (they all load the same file);
+    //  - the endpoints are in chain order, so every stage but the last is a relay and the last is
+    //    the tail;
+    //  - the layer ranges must tile: stage i starts where the previous one ended (the head for
+    //    the first stage), and the last stage ends at the head's n_layer_src. Each stage proves
+    //    the first half of that from its own layer_lo; the last one proves the far end.
+    // The only number this side cannot know before the stage answers is a middle stage's layer_hi
+    // -- it is whatever the next stage starts at. So it is pinned to ID_ANY_I32 and the next
+    // iteration pins the next stage's layer_lo to the layer_hi that stage just reported. The
+    // result is the same tiling check split_attach() performs for local stages, over the wire.
+    const int32_t  n_layer_src = expect.n_layer_src;
+    const uint32_t n_embd_hop  = expect.n_embd;
+    const uint32_t n_vocab     = expect.n_vocab;
+    // [QLH-SPLIT] v10: the four chain-identity numbers, for the same reason as the three above --
+    // they can only come from the head, and the handshake is where the two ends compare them. A stage
+    // built with a different -np / -c / --rs-seq / --split-verify-rows is refused here, before it
+    // computes anything, instead of failing a request in the middle.
+    const uint32_t n_seq_max     = expect.n_seq_max;
+    const uint32_t n_ctx_seq     = expect.n_ctx_seq;
+    const uint32_t n_rs_seq      = expect.n_rs_seq;
+    const uint32_t n_verify_rows = expect.n_verify_rows;
+    int32_t        prev_hi     = model.hparams.layer_hi;
+
+    for (size_t i = 0; i < endpoints.size(); ++i) {
+        auto r = std::make_unique<llama_split_remote>();
+        if (!r->connect(endpoints[i], err)) {
+            split_remotes.clear();
+            return -1;
+        }
+
+        const bool last = (i + 1 == endpoints.size());
+        qlh_split::stage_id expect{};
+        expect.layer_lo    = prev_hi;
+        expect.layer_hi    = last ? n_layer_src : qlh_split::ID_ANY_I32;
+        expect.n_layer_src = n_layer_src;
+        expect.n_embd_inp  = n_embd_hop;
+        expect.n_embd_out  = n_embd_hop;
+        expect.n_vocab     = n_vocab;
+        expect.role        = last ? qlh_split::ROLE_TAIL : qlh_split::ROLE_RELAY;
+        // The wire field is uint16 (LLAMA_MAX_SEQ is 256), the head's n_seq_max is uint32; the
+        // cast is safe because the context constructor already refused anything above LLAMA_MAX_SEQ.
+        expect.n_seq_max     = (uint16_t) n_seq_max;
+        expect.n_ctx_seq     = n_ctx_seq;
+        expect.n_rs_seq      = n_rs_seq;
+        expect.n_verify_rows = n_verify_rows;
+
+        qlh_split::stage_id got{};
+        std::string why;
+        if (!r->hello(expect, &got, why)) {
+            err = "remote stage " + std::to_string(i + 1) + ": " + why;
+            split_remotes.clear();
+            return -1;
+        }
+        prev_hi = got.layer_hi;
+        split_remotes.push_back(std::move(r));
+    }
+
+    // Install the union view over the head and the remote stages: llama_get_memory() is what
+    // llama-server's KV bookkeeping mutates, and for a remote chain the only stage with a local
+    // memory object is the head. Without this the age-old "nobody trims the remote KV" bug
+    // stays: the head trims, the remote keeps serving from positions the head no longer has.
+    std::vector<llama_split_remote *> remote_ptrs;
+    remote_ptrs.reserve(split_remotes.size());
+    for (auto & r : split_remotes) {
+        remote_ptrs.push_back(r.get());
+    }
+    // The head argument is this context's own memory, not get_memory(): the accessor answers with
+    // split_memory once a chain exists, and split_memory.reset() above only happens to make the
+    // two equal here. Spelling out `memory` is what makes a future edit of that reset harmless.
+    split_memory = std::make_unique<llama_memory_split>(
+            memory.get(), std::vector<llama_memory_t>{}, remote_ptrs);
+
+    return (int) split_remotes.size();
+}
+
+// [QLH-SPLIT] Attach local stages. Returns the number attached, or -1 with a logged reason.
+//
+// The contiguity check is the reason this returns a value at all: every stage is loaded on its
+// own (possibly in another process), so nothing after the loader can see that the ranges do not
+// tile the source model. Before this, a wrong --split-tail-range was accepted and produced
+// logits that were merely plausible, with no error anywhere.
