+    GGML_ASSERT(gsmpl->cur_p.selected >= 0 && gsmpl->cur_p.selected < (int32_t) gsmpl->cur_p.size);
+
+    return gsmpl->cur_p.data[gsmpl->cur_p.selected].id;
