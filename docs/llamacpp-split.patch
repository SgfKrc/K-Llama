+                n_null++;
+                continue;
+            }
+            memcpy(chain.data() + (size_t) i * n_vocab, lg, sizeof(float) * n_vocab);
+        }
+        printf("[B] chain rows with logits: %d/%d\n", n_tok - n_null, n_tok);
+
+        const float * h = llama_get_embeddings_nextn_ith(c_tail, n_tok - 1);
