+        return;
+    }
+
+    ggml_tensor * states = ggml_reshape_2d(ctx0, s, state_size, s->ne[1]);
+
+    auto row = [&](int64_t slot, uint32_t cell) {
+        return ggml_view_2d(ctx0, states, state_size, 1, states->nb[1],
+                (size_t) (slot*(int64_t) rs_size + cell)*states->nb[1]);
+    };
+
+    for (uint32_t i = 0; i < n_rs; ++i) {
+        const uint32_t cell = rs_head + i;
+        if (cell >= rs_size) {
+            break;
+        }
+
+        const int64_t r = i < shifts.size() ? (int64_t) shifts[i] : 0;
+        if (r == n_tok) {
+            // the pre-batch head is exactly one slot away: every slot already holds the
+            // state of "last position - s", nothing to move
+            continue;
+        }
+
+        // slot s of the new layout holds the state of position (head + n_tok - s), which
+        // was slot (s + r - n_tok) of the old layout (head was rewound by r tokens).
+        // walking the slots from high to low is safe while the sources are below the
+        // destinations; when they are above, walk low to high instead, so every source is
+        // read before something overwrites it.
+        const bool ascending = r > n_tok;
+
+        for (int64_t k = 0; k < K - n_tok; ++k) {
+            const int64_t sl  = ascending ? n_tok + k : K - 1 - k;
+            const int64_t src = sl + r - n_tok;
+
+            if (src >= 0 && src < K) {
+                ggml_build_forward_expand(gf, ggml_cpy(ctx0, row(src, cell), row(sl, cell)));
+            } else {
+                // no such history yet (a rollback deeper than the recorded snapshots)
+                ggml_build_forward_expand(gf, ggml_scale_inplace(ctx0, row(sl, cell), 0.0f));
+            }
+        }
