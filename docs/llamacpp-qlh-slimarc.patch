+void prefetch_scheduler::shutdown() noexcept {
+    std::lock_guard<std::mutex> shutdown_lock(shutdown_mtx_);
+    {
+        std::lock_guard<std::mutex> lk(mtx_);
+        if (stop_.load()) return;
+        enabled_.store(false);
+        stop_.store(true);
+        pending_requests_.clear();
