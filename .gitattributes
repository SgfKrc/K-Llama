# cmd.exe 对 LF-only 批处理的 for/f 块解析不可靠（实测崩溃），
# 该构建脚本必须始终以 CRLF 行尾存储和检出。
packaging/build-launcher.bat text eol=crlf
# Windows 一键环境配置脚本同样必须 CRLF（否则 cmd 对 UTF-8 REM 行与 && 解析会崩）
setup_all_envs.bat text eol=crlf
# submodule 初始化脚本同理（cmd 对 LF-only 的 if/goto 解析会崩）
scripts/init-submodules.bat text eol=crlf
# TUI 启动脚本同理
start_tui.bat text eol=crlf
# 统一入口的别名薄壳（K-Llama / koakuma / bjtu = qlh）
K-Llama.bat text eol=crlf
koakuma.bat text eol=crlf
bjtu.bat text eol=crlf
qlh.bat text eol=crlf
# git 钩子必须是 LF：这些是带 `#!/bin/sh` shebang 的 shell 脚本，CRLF 会让解释器
# 把 `\r` 当成命令的一部分而在 Windows 检出后直接执行失败（core.hooksPath 指向它们）。
.githooks/* text eol=lf

# These byte-addressed quality fixtures have existing CRLF SHA-256 locks.
# Pin checkout bytes on Linux as well as Windows; do not rewrite their locks.
fixtures/prompt_sets/ps-qwen3-nothink/prompts.jsonl text eol=crlf
fixtures/quality_rubrics/llm-objective-ps-v1-v2.json text eol=crlf
fixtures/quality_rubrics/gemma-judge-counts-v1.json text eol=crlf
fixtures/quality_reports/gemma-judge-counts-fixture-v1.json text eol=crlf
# Managed patches carry raw LF SHA-256 pins; keep checkout bytes stable on Windows.
scripts/model_tools/patches/*.patch text eol=lf
