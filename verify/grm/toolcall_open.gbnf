# Same shape as toolcall.gbnf, but the arguments block is free JSON (any keys, any values).
# This is what a schema with additionalProperties / loose arguments looks like.
root    ::= "{" ws "\"name\"" ws ":" ws "\"" [a-zA-Z_][a-zA-Z0-9_]* "\"" ws "," ws "\"arguments\"" ws ":" ws value ws "}" ws
value   ::= object | array | string | number | ("true" | "false" | "null") ws
object  ::= "{" ws (string ":" ws value ("," ws string ":" ws value)*)? "}" ws
array   ::= "[" ws (value ("," ws value)*)? "]" ws
string  ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}))* "\"" ws
number  ::= ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ([eE] [-+]? [0-9] [1-9]{0,15})? ws
ws      ::= [ \t\n]*
